PORT=3000
# Сгенерируйте случайный 32+ символов, например: openssl rand -hex 24
# На проде обязателен (без него сервис не стартует). Тот же ключ пропишите в BSL-модуль 1С.
INGEST_API_KEY=
POSTGRES_DB=sales_dashboard
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@db:5432/sales_dashboard

# Опциональные интеграции
DASHBOARD_PIN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# CORS. '*' = открыто всем origin'ам (текущее, как исторически — любой сайт может читать
# публичные эндпоинты). Чтобы запереть на свой фронт-домен — указать конкретный origin
# (scheme+host[:port], напр. https://dashboard.example.ru). Пусто = same-origin (CORS-заголовков
# нет; подходит когда дашборд и API на одном origin). NB: docker-compose дефолтит в '*'.
CORS_ORIGIN=*

# LLM-маркетинг-анализ (если ключ не задан — используется встроенный rules engine)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Pull-интеграция с 1С УПП (опционально). Дашборд сам ходит в HTTP-сервис УПП.
# Если URL не задан — pull выключен (push через /api/ingest/upp работает всегда).
# UPP_PULL_INTERVAL_MIN=0 — pull только по кнопке/POST /api/upp/pull;
# UPP_PULL_INTERVAL_MIN=60 — авто-pull раз в час.
UPP_PULL_URL=
UPP_PULL_USER=
UPP_PULL_PASSWORD=
UPP_PULL_INTERVAL_MIN=0
