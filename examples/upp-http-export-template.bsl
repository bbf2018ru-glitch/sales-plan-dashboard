// Модуль: ДашбордПродаж (Общий модуль, флаги: Сервер + Вызов сервера)
// Назначение: отправка данных продаж и планов из 1С УПП в дашборд.
// Запуск: через Регламентное задание раз в час.
//
// ─── ИСТОЧНИКИ ДАННЫХ (УТОЧНЕНО ЗАКАЗЧИКОМ) ───────────────────────────────────
//
// 1. Розничные точки — из отчёта «Валовая Прибыль»,
//    фильтр: группа складов «Розничные склады Мария».
//    Регистр: РегистрНакопления.ВаловаяПрибыль.
//
// 2. Опт / онлайн / B2B — из отчёта «Валовая Прибыль (упр.)»,
//    фильтр: 6 подразделений
//      • Агрегатор
//      • Опт
//      • Отдел интернет продаж
//      • Отдел Интернет продаж Ангарск
//      • Отдел Продаж ЗП
//      • Корпоративные клиенты
//    Регистр: РегистрНакопления.ВаловаяПрибыльУпр (управленческий).
//
// 3. План для опт / онлайн / B2B — из документа «Установка план-факт»
//    по тем же 6 подразделениям.
//    Регистр движений документа: уточнить у разработчика 1С (см. ниже).
//
// На дашборде розничные точки и подразделения отображаются как «точки» в
// единой таблице. Чтобы их визуально различать, у розницы region = "Иркутск"
// (или фактический регион склада), у управленческих — region = "Управленческий".

// ─── ТОЧКА ВХОДА ──────────────────────────────────────────────────────────────

Процедура ВыполнитьВыгрузкуВДашборд() Экспорт

    Хост   = "sales-plan-dashboard.onrender.com";
    Порт   = 443;
    Путь   = "/api/ingest/upp";
    ApiKey = "85307b26064e3764b0b19ce3223353057b0fe754b31f0f3a";

    НачалоМесяца = НачалоМесяца(ТекущаяДата());
    КонецПериода = КонецДня(ТекущаяДата());
    Период       = Формат(НачалоМесяца, "ДФ=yyyy-MM");
    ИдПакета     = "maria-" + Формат(ТекущаяДата(), "ДФ=yyyyMMdd-HHmmss");

    РезРозница = ПолучитьПродажиРозница(НачалоМесяца, КонецПериода);
    РезУпр     = ПолучитьПродажиУпр(НачалоМесяца, КонецПериода);
    РезПланУпр = ПолучитьПланУпр(НачалоМесяца, КонецПериода);

    Пакет = Новый Структура;
    Пакет.Вставить("sourceSystem", "1c-upp");
    Пакет.Вставить("sourceObject", "sales_exchange");
    Пакет.Вставить("packageId",    ИдПакета);
    Пакет.Вставить("period",       Период);
    Пакет.Вставить("stores",       СобратьМагазины(РезРозница, РезУпр, РезПланУпр));
    Пакет.Вставить("products",     СобратьНоменклатуру(РезРозница, РезУпр));
    Пакет.Вставить("plans",        СформироватьПланы(РезПланУпр));
    Пакет.Вставить("sales",        СформироватьПродажи(РезРозница, РезУпр));

    JSONСтрока = СериализоватьJSON(Пакет);
    Ответ      = ОтправитьPOST(Хост, Порт, Путь, ApiKey, JSONСтрока);
    Сообщить("Дашборд: " + Ответ);

КонецПроцедуры

// ─── РОЗНИЦА: ВАЛОВАЯ ПРИБЫЛЬ ПО ГРУППЕ СКЛАДОВ ───────────────────────────────
//
// Источник: РегистрНакопления.ВаловаяПрибыль
// Фильтр:   Склад В ИЕРАРХИИ группы «Розничные склады Мария»
//
// УТОЧНИТЬ У РАЗРАБОТЧИКА 1С:
//   1. Точное наименование группы складов в справочнике «Склады».
//      Возможные варианты: «Розничные склады Мария», «Розничные склады»,
//      «Магазины Мария». Поле НаименованиеГруппыРозницы — в начале процедуры.
//   2. Имя ресурса с выручкой и себестоимостью:
//      типовая УПП — «ВыручкаОборот» / «СтоимостьОборот».
//   3. Какое измерение использовать как идентификатор точки на дашборде:
//      Склад.Код или Склад.Наименование.

Функция ПолучитьПродажиРозница(НачПериода, КонПериода)

    НаименованиеГруппыРозницы = "Розничные склады Мария";

    ГруппаСкладов = НайтиГруппуСкладовПоИмени(НаименованиеГруппыРозницы);
    Если ГруппаСкладов = Неопределено Тогда
        Сообщить("Розница: группа складов '" + НаименованиеГруппыРозницы
            + "' не найдена в справочнике Склады. Проверьте имя группы.");
        Возврат Новый ТаблицаЗначений;
    КонецЕсли;

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |    ВП.Склад.Код                                       КАК ТочкаКод,
    |    ВП.Склад.Наименование                              КАК ТочкаНаим,
    |    ВП.Номенклатура.Код                                КАК ТоварКод,
    |    ВП.Номенклатура.Наименование                       КАК ТоварНаим,
    |    ВП.Номенклатура.НоменклатурнаяГруппа.Наименование  КАК Категория,
    |    СУММА(ВП.КоличествоОборот)                         КАК Количество,
    |    СУММА(ВП.ВыручкаОборот)                            КАК Выручка,
    |    СУММА(ВП.СтоимостьОборот)                          КАК Себестоимость
    |ИЗ
    |    РегистрНакопления.ВаловаяПрибыль.Обороты(
    |        &НачПериода, &КонПериода, Авто, Склад В ИЕРАРХИИ (&ГруппаСкладов)) КАК ВП
    |СГРУППИРОВАТЬ ПО
    |    ВП.Склад,
    |    ВП.Номенклатура";

    Запрос.УстановитьПараметр("НачПериода",    НачПериода);
    Запрос.УстановитьПараметр("КонПериода",    КонПериода);
    Запрос.УстановитьПараметр("ГруппаСкладов", ГруппаСкладов);

    Попытка
        Возврат Запрос.Выполнить().Выгрузить();
    Исключение
        Сообщить("Розница (ВаловаяПрибыль) — ошибка запроса: " + ОписаниеОшибки());
        Возврат Новый ТаблицаЗначений;
    КонецПопытки;

КонецФункции

Функция НайтиГруппуСкладовПоИмени(Имя)

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |    Склады.Ссылка КАК Ссылка
    |ИЗ
    |    Справочник.Склады КАК Склады
    |ГДЕ
    |    Склады.ЭтоГруппа = ИСТИНА
    |    И Склады.Наименование = &Имя";

    Запрос.УстановитьПараметр("Имя", Имя);

    Попытка
        Выборка = Запрос.Выполнить().Выбрать();
        Если Выборка.Следующий() Тогда
            Возврат Выборка.Ссылка;
        КонецЕсли;
    Исключение
        Сообщить("Поиск группы складов '" + Имя + "' — ошибка: " + ОписаниеОшибки());
    КонецПопытки;

    Возврат Неопределено;

КонецФункции

// ─── ОПТ/ОНЛАЙН/B2B: ВАЛОВАЯ ПРИБЫЛЬ (УПР.) ПО 6 ПОДРАЗДЕЛЕНИЯМ ───────────────
//
// Источник: РегистрНакопления.ВаловаяПрибыльУпр
// Фильтр:   Подразделение В списке наименований
//
// УТОЧНИТЬ У РАЗРАБОТЧИКА 1С:
//   1. Точное имя регистра. В типовой УПП 1.3 — «ВаловаяПрибыльУпр».
//      В кастомных может быть «ВаловаяПрибыльУправленческий» или другой.
//   2. Точные наименования подразделений в справочнике «Подразделения».
//      Список ниже — то что назвал заказчик. Если не совпадают по символам
//      (регистр, пробелы, кавычки) — поправить.
//   3. Имя ресурсов: «ВыручкаОборот» / «СтоимостьОборот».

Функция ПолучитьПродажиУпр(НачПериода, КонПериода)

    Подразделения = НайтиПодразделенияПоИменам();
    Если Подразделения.Количество() = 0 Тогда
        Сообщить("Упр.учёт: ни одно из 6 подразделений не найдено в справочнике. "
            + "Проверьте наименования.");
        Возврат Новый ТаблицаЗначений;
    КонецЕсли;

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |    ВПУ.Подразделение.Код                              КАК ТочкаКод,
    |    ВПУ.Подразделение.Наименование                     КАК ТочкаНаим,
    |    ВПУ.Номенклатура.Код                               КАК ТоварКод,
    |    ВПУ.Номенклатура.Наименование                      КАК ТоварНаим,
    |    ВПУ.Номенклатура.НоменклатурнаяГруппа.Наименование КАК Категория,
    |    СУММА(ВПУ.КоличествоОборот)                        КАК Количество,
    |    СУММА(ВПУ.ВыручкаОборот)                           КАК Выручка,
    |    СУММА(ВПУ.СтоимостьОборот)                         КАК Себестоимость
    |ИЗ
    |    РегистрНакопления.ВаловаяПрибыльУпр.Обороты(
    |        &НачПериода, &КонПериода, Авто, Подразделение В (&Подразделения)) КАК ВПУ
    |СГРУППИРОВАТЬ ПО
    |    ВПУ.Подразделение,
    |    ВПУ.Номенклатура";

    Запрос.УстановитьПараметр("НачПериода",    НачПериода);
    Запрос.УстановитьПараметр("КонПериода",    КонПериода);
    Запрос.УстановитьПараметр("Подразделения", Подразделения);

    Попытка
        Возврат Запрос.Выполнить().Выгрузить();
    Исключение
        Сообщить("Упр.учёт (ВаловаяПрибыльУпр) — ошибка запроса: " + ОписаниеОшибки());
        Возврат Новый ТаблицаЗначений;
    КонецПопытки;

КонецФункции

Функция НайтиПодразделенияПоИменам()

    Имена = Новый Массив;
    Имена.Добавить("Агрегатор");
    Имена.Добавить("Опт");
    Имена.Добавить("Отдел интернет продаж");
    Имена.Добавить("Отдел Интернет продаж Ангарск");
    Имена.Добавить("Отдел Продаж ЗП");
    Имена.Добавить("Корпоративные клиенты");

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |    Подр.Ссылка        КАК Ссылка,
    |    Подр.Наименование  КАК Наименование
    |ИЗ
    |    Справочник.Подразделения КАК Подр
    |ГДЕ
    |    Подр.Наименование В (&Имена)
    |    И Подр.ЭтоГруппа = ЛОЖЬ";

    Запрос.УстановитьПараметр("Имена", Имена);

    Список   = Новый Массив;
    Найдено  = Новый Массив;

    Попытка
        Выборка = Запрос.Выполнить().Выбрать();
        Пока Выборка.Следующий() Цикл
            Список.Добавить(Выборка.Ссылка);
            Найдено.Добавить(Выборка.Наименование);
        КонецЦикла;
    Исключение
        Сообщить("Поиск подразделений — ошибка: " + ОписаниеОшибки());
    КонецПопытки;

    // Сообщить какие подразделения не нашли — чтобы было видно опечатки
    Для Каждого Имя Из Имена Цикл
        НайденоЛи = Ложь;
        Для Каждого Н Из Найдено Цикл
            Если СокрЛП(Н) = СокрЛП(Имя) Тогда
                НайденоЛи = Истина;
                Прервать;
            КонецЕсли;
        КонецЦикла;
        Если Не НайденоЛи Тогда
            Сообщить("Подразделение НЕ НАЙДЕНО: '" + Имя
                + "' — проверьте имя в справочнике Подразделения.");
        КонецЕсли;
    КонецЦикла;

    Возврат Список;

КонецФункции

// ─── ПЛАН ДЛЯ УПР.УЧЁТА: ИЗ ДОКУМЕНТА «УСТАНОВКА ПЛАН-ФАКТ» ───────────────────
//
// Заказчик указал источник: документ «Установка план-факт» по тем же
// 6 подразделениям, что и упр.продажи.
//
// УТОЧНИТЬ У РАЗРАБОТЧИКА 1С:
//   1. Точное имя документа в конфигурации:
//      Документ.УстановкаПланФакт / УстановкаПланаФакт / ПланФактУстановка / …
//   2. Какой регистр накопления получает движения этого документа.
//      Стандартные варианты: ПланыПродаж, ПланыПродажОбъемно, ПланыПродажКомплектов,
//      или собственный регистр (например ПланыПродажУпр).
//   3. По каким измерениям выгружать (Подразделение / Номенклатура / Период).
//
// Ниже — два варианта запроса. Оставить тот, который соответствует конфигурации.

Функция ПолучитьПланУпр(НачПериода, КонПериода)

    Подразделения = НайтиПодразделенияПоИменам();
    Если Подразделения.Количество() = 0 Тогда
        Возврат Новый ТаблицаЗначений;
    КонецЕсли;

    // ─── ВАРИАНТ A: через регистр накопления (предпочтительно) ────────────────
    // Если документ «Установка план-факт» делает движения в регистр —
    // читаем регистр. Замените имя регистра, если нужно.

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |    П.Подразделение.Код           КАК ТочкаКод,
    |    П.Подразделение.Наименование  КАК ТочкаНаим,
    |    П.Номенклатура.Код            КАК ТоварКод,
    |    П.Номенклатура.Наименование   КАК ТоварНаим,
    |    СУММА(П.СуммаОборот)          КАК СуммаПлана
    |ИЗ
    |    РегистрНакопления.ПланыПродаж.Обороты(
    |        &НачПериода, &КонПериода, Авто, Подразделение В (&Подразделения)) КАК П
    |СГРУППИРОВАТЬ ПО
    |    П.Подразделение,
    |    П.Номенклатура";

    Запрос.УстановитьПараметр("НачПериода",    НачПериода);
    Запрос.УстановитьПараметр("КонПериода",    КонПериода);
    Запрос.УстановитьПараметр("Подразделения", Подразделения);

    Попытка
        Возврат Запрос.Выполнить().Выгрузить();
    Исключение
        Сообщить("План (ПланыПродаж) — ошибка: " + ОписаниеОшибки()
            + ". Возможно, регистр называется иначе или план хранится прямо в документе. "
            + "Использовать ВАРИАНТ B (см. комментарий в коде).");
        Возврат Новый ТаблицаЗначений;
    КонецПопытки;

    // ─── ВАРИАНТ B: чтение прямо из табличной части документа ─────────────────
    // Раскомментировать если регистра нет, и поправить под фактическую структуру.
    //
    // Запрос.Текст =
    // "ВЫБРАТЬ
    // |    Док.Подразделение.Код          КАК ТочкаКод,
    // |    Док.Подразделение.Наименование КАК ТочкаНаим,
    // |    Стр.Номенклатура.Код           КАК ТоварКод,
    // |    Стр.Номенклатура.Наименование  КАК ТоварНаим,
    // |    СУММА(Стр.Сумма)               КАК СуммаПлана
    // |ИЗ
    // |    Документ.УстановкаПланФакт КАК Док
    // |        ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.УстановкаПланФакт.Товары КАК Стр
    // |        ПО Стр.Ссылка = Док.Ссылка
    // |ГДЕ
    // |    Док.Проведен = ИСТИНА
    // |    И Док.Дата МЕЖДУ &НачПериода И &КонПериода
    // |    И Док.Подразделение В (&Подразделения)
    // |СГРУППИРОВАТЬ ПО
    // |    Док.Подразделение,
    // |    Стр.Номенклатура";

КонецФункции

// ─── СБОРКА СТРУКТУР ДЛЯ JSON ─────────────────────────────────────────────────

Функция СобратьМагазины(ТабРозница, ТабУпр, ТабПлан)

    Точки = Новый Соответствие;

    Для Каждого Стр Из ТабРозница Цикл
        Если ПустаяСтрока(Стр.ТочкаКод) Тогда Продолжить; КонецЕсли;
        Точки.Вставить(Стр.ТочкаКод, Новый Структура(
            "id,name,region", Стр.ТочкаКод, Стр.ТочкаНаим, "Иркутск"));
    КонецЦикла;

    Для Каждого Стр Из ТабУпр Цикл
        Если ПустаяСтрока(Стр.ТочкаКод) Тогда Продолжить; КонецЕсли;
        Если Точки.Получить(Стр.ТочкаКод) = Неопределено Тогда
            Точки.Вставить(Стр.ТочкаКод, Новый Структура(
                "id,name,region", Стр.ТочкаКод, Стр.ТочкаНаим, "Управленческий"));
        КонецЕсли;
    КонецЦикла;

    Для Каждого Стр Из ТабПлан Цикл
        Если ПустаяСтрока(Стр.ТочкаКод) Тогда Продолжить; КонецЕсли;
        Если Точки.Получить(Стр.ТочкаКод) = Неопределено Тогда
            Точки.Вставить(Стр.ТочкаКод, Новый Структура(
                "id,name,region", Стр.ТочкаКод, Стр.ТочкаНаим, "Управленческий"));
        КонецЕсли;
    КонецЦикла;

    Результат = Новый Массив;
    Для Каждого КЗ Из Точки Цикл
        Результат.Добавить(КЗ.Значение);
    КонецЦикла;
    Возврат Результат;

КонецФункции

Функция СобратьНоменклатуру(ТабРозница, ТабУпр)

    Товары = Новый Соответствие;
    ДобавитьТоварыИзТаблицы(Товары, ТабРозница);
    ДобавитьТоварыИзТаблицы(Товары, ТабУпр);

    Результат = Новый Массив;
    Для Каждого КЗ Из Товары Цикл
        Результат.Добавить(КЗ.Значение);
    КонецЦикла;
    Возврат Результат;

КонецФункции

Процедура ДобавитьТоварыИзТаблицы(Товары, Таблица)

    Для Каждого Стр Из Таблица Цикл
        Если ПустаяСтрока(Стр.ТоварКод) Тогда Продолжить; КонецЕсли;
        Категория = Стр.Категория;
        Если ПустаяСтрока(Категория) Тогда Категория = "Прочее"; КонецЕсли;
        Если Товары.Получить(Стр.ТоварКод) = Неопределено Тогда
            Товары.Вставить(Стр.ТоварКод, Новый Структура(
                "id,name,category", Стр.ТоварКод, Стр.ТоварНаим, Категория));
        КонецЕсли;
    КонецЦикла;

КонецПроцедуры

Функция СформироватьПланы(ТабПлан)

    Результат = Новый Массив;
    Для Каждого Стр Из ТабПлан Цикл
        Если ПустаяСтрока(Стр.ТочкаКод) Или ПустаяСтрока(Стр.ТоварКод) Тогда
            Продолжить;
        КонецЕсли;
        Результат.Добавить(Новый Структура(
            "storeId,productId,amount",
            Стр.ТочкаКод, Стр.ТоварКод, Стр.СуммаПлана));
    КонецЦикла;
    Возврат Результат;

КонецФункции

Функция СформироватьПродажи(ТабРозница, ТабУпр)

    Результат = Новый Массив;
    ДатаПродажи = Формат(ТекущаяДата(), "ДФ=yyyy-MM-ddTHH:mm:ss") + "+08:00";

    ДобавитьПродажиИзТаблицы(Результат, ТабРозница, ДатаПродажи);
    ДобавитьПродажиИзТаблицы(Результат, ТабУпр, ДатаПродажи);

    Возврат Результат;

КонецФункции

Процедура ДобавитьПродажиИзТаблицы(Результат, Таблица, ДатаПродажи)

    Для Каждого Стр Из Таблица Цикл
        Если ПустаяСтрока(Стр.ТочкаКод) Или ПустаяСтрока(Стр.ТоварКод) Тогда
            Продолжить;
        КонецЕсли;

        Себестоимость  = Стр.Себестоимость;
        ВаловаяПрибыль = Стр.Выручка - Стр.Себестоимость;

        Результат.Добавить(Новый Структура(
            "storeId,productId,amount,cost,grossProfit,quantity,soldAt",
            Стр.ТочкаКод,
            Стр.ТоварКод,
            Стр.Выручка,
            Себестоимость,
            ВаловаяПрибыль,
            Стр.Количество,
            ДатаПродажи));
    КонецЦикла;

КонецПроцедуры

// ─── HTTP ─────────────────────────────────────────────────────────────────────

Функция СериализоватьJSON(Значение)

    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, Значение);
    Возврат ЗаписьJSON.Закрыть();

КонецФункции

Функция ОтправитьPOST(Хост, Порт, Путь, ApiKey, ТелоJSON)

    Защита     = Новый ЗащищенноеСоединениеOpenSSL();
    // Таймаут не задаём (6-й параметр пустой) — иначе на сервере 1С УПП запрос
    // не уходит. Проверено на конфигурации заказчика.
    Соединение = Новый HTTPСоединение(Хост, Порт,,,,, Защита);
    Запрос     = Новый HTTPЗапрос(Путь);
    Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    Запрос.Заголовки.Вставить("X-API-Key", ApiKey);
    Запрос.УстановитьТелоИзСтроки(ТелоJSON, КодировкаТекста.UTF8);

    Ответ        = Соединение.ОтправитьДляОбработки(Запрос);
    ОтветСтрокой = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);

    Если Ответ.КодСостояния <> 200 Тогда
        ВызватьИсключение "Дашборд HTTP=" + Ответ.КодСостояния + ": " + ОтветСтрокой;
    КонецЕсли;

    Возврат ОтветСтрокой;

КонецФункции
