            "code,name,group,unit,unitRatio,weight,kind",
            "" + Стр.Код, "" + Стр.Имя, "" + Стр.Группа,
            "" + Стр.БазЕд, Стр.Коэф, Стр.Вес, "" + Стр.ВидНоменклатуры));
    КонецЦикла;
    Возврат ОтветJSON(Новый Структура("rowsCount,rows",
        Строки.Количество(), Строки));
КонецФункции


