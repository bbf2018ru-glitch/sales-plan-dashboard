// ─── /register?name=...&from=...&to=...&limit=... ────────────────────────────
// Универсальные обороты регистра накопления за период.
// Возвращает сырые строки (без агрегаций).
//
Функция ВыполнитьRegister(Запрос) Экспорт

    Имя = Запрос.ПараметрыЗапроса.Получить("name");
    ОтДата = РазобратьПериодYYYY_MM(Запрос.ПараметрыЗапроса.Получить("from"));
    ДоДата = РазобратьПериодYYYY_MM(Запрос.ПараметрыЗапроса.Получить("to"));
    ЛимитСтр = Запрос.ПараметрыЗапроса.Получить("limit");
    Лимит = ?(ПустаяСтрока(ЛимитСтр), 1000, Мин(Макс(Число(ЛимитСтр), 1), 10000));

    Если ПустаяСтрока(Имя) Тогда
        Возврат ОтветОшибки(400, "name обязателен");
    КонецЕсли;
    Если ОтДата = Неопределено Или ДоДата = Неопределено Тогда
        Возврат ОтветОшибки(400, "from и to обязательны (YYYY-MM)");
    КонецЕсли;

    МД = Метаданные.РегистрыНакопления.Найти(Имя);
    Если МД = Неопределено Тогда
        Возврат ОтветОшибки(404, "Регистр накопления " + Имя + " не найден");
    КонецЕсли;

    НачП = НачалоМесяца(ОтДата);
    КонП = КонецДня(КонецМесяца(ДоДата));

    // Динамический запрос — измерения + ресурсы регистра
    Колонки = Новый Массив;
    Колонки.Добавить("Период");
    Для Каждого Изм Из МД.Измерения Цикл
        Колонки.Добавить(Изм.Имя);
    КонецЦикла;
    Для Каждого Рес Из МД.Ресурсы Цикл
        Колонки.Добавить(Рес.Имя);
    КонецЦикла;

    СтрПоля = "";
    Для Каждого К Из Колонки Цикл
        СтрПоля = СтрПоля + ?(СтрПоля = "", "", ", ") + "Р." + К;
    КонецЦикла;

    ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит, "ЧГ=") + " " + СтрПоля
        + " ИЗ РегистрНакопления." + Имя + " КАК Р"
        + " ГДЕ Р.Период МЕЖДУ &Н И &К";

    Запрос1С = Новый Запрос(ТекстЗапроса);
    Запрос1С.УстановитьПараметр("Н", НачП);
    Запрос1С.УстановитьПараметр("К", КонП);

    Попытка
        Таблица = Запрос1С.Выполнить().Выгрузить();
    Исключение
        Возврат ОтветОшибки(500, "Ошибка запроса: " + ОписаниеОшибки());
    КонецПопытки;

    Строки = Новый Массив;
    Для Каждого Стр Из Таблица Цикл
        Зап = Новый Структура;
        Для Каждого К Из Колонки Цикл
            Зап.Вставить(К, "" + Стр[К]);
        КонецЦикла;
        Строки.Добавить(Зап);
    КонецЦикла;

    Возврат ОтветJSON(Новый Структура(
        "register,from,to,rowsCount,rows",
        Имя, Формат(НачП, "ДФ=yyyy-MM-dd"), Формат(КонП, "ДФ=yyyy-MM-dd"),
        Строки.Количество(), Строки));

КонецФункции


// ─── СБОРКА ПАКЕТА ЗА ПЕРИОД ─────────────────────────────────────────────────
// Используется и /pull, и /pull-range. Реиспользует функции из общего
// модуля ДашбордПродаж (если он установлен в этой же конфе). Если общего
// модуля нет — встроенный fallback ниже.
//
Функция СобратьПакетЗаПериод(НачПериода, КонПериода, Период)

    // Сборка пакета — все запросы встроены сюда, чтобы HTTP-сервис не
    // зависел от общего модуля ДашбордПродаж (его функции не экспортные).
    ИдПакета = "maria-" + Период + "-" + Формат(ТекущаяДата(), "ДФ=yyyyMMddHHmmss") + "-pull";

    РезПродажи      = _ПолучитьПродажи(НачПериода, КонПериода);
    РезСебестоимость = _ПолучитьСебестоимость(НачПериода, КонПериода);
    РезПланы         = _ПолучитьПланы(НачПериода);
    РезЧеки          = _ПолучитьСтатистикуЧеков(НачПериода, КонПериода);

    Пакет = Новый Структура;
    Пакет.Вставить("sourceSystem",     "1c-upp");
    Пакет.Вставить("sourceObject",     "sales_exchange");
    Пакет.Вставить("packageId",        ИдПакета);
    Пакет.Вставить("period",           Период);
    Пакет.Вставить("stores",           _СобратьМагазины(РезПродажи, РезПланы));
    Пакет.Вставить("products",         _СобратьНоменклатуру(РезПродажи));
    Пакет.Вставить("plans",            _СформироватьПланы(РезПланы));
    Пакет.Вставить("sales",            _СформироватьПродажи(РезПродажи, РезСебестоимость));
    Пакет.Вставить("cheques",          _СформироватьСтатистикуЧеков(РезЧеки));
    Пакет.Вставить("marketingMetrics", Новый Массив);

    Возврат Пакет;

КонецФункции


// ════════════════════════════════════════════════════════════════════════════
// ВНУТРЕННИЕ ЗАПРОСЫ К 1С (копия логики из общего модуля ДашбордПродаж)
// ════════════════════════════════════════════════════════════════════════════

Функция _ПолучитьПродажи(НачПериода, КонПериода)
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |    ВложенныйЗапрос.Склад.Код                                         КАК СкладКод,
    |    ВложенныйЗапрос.Склад.Наименование                                КАК СкладНаим,
    |    ВложенныйЗапрос.Номенклатура.Код                                  КАК ТоварКод,
    |    ВложенныйЗапрос.Номенклатура.Наименование                         КАК ТоварНаим,
    |    ВложенныйЗапрос.Номенклатура.НоменклатурнаяГруппа.Наименование    КАК Категория,
    |    ВложенныйЗапрос.Источник                                          КАК Источник,
    |    СУММА(ВложенныйЗапрос.Количество)                                 КАК Количество,
    |    СУММА(ВложенныйЗапрос.Сумма)                                      КАК Выручка,
    |    МАКСИМУМ(ВложенныйЗапрос.Период)                                  КАК ПоследняяДата
    |ИЗ
    |    (ВЫБРАТЬ
    |        ЧекККМТовары.Ссылка.Дата                                      КАК Период,
    |        ЧекККМТовары.Ссылка.Склад                                     КАК Склад,
    |        ЧекККМТовары.Номенклатура                                     КАК Номенклатура,
    |        ЧекККМТовары.Количество                                       КАК Количество,
    |        ЧекККМТовары.Сумма
    |          - ЧекККМТовары.СуммаСкидки
    |          - ЧекККМТовары.ОплатаПодарочнымиСертификатами
    |          - ЧекККМТовары.ОплатаБонусами                               КАК Сумма,
    |        ""retail""                                                    КАК Источник
    |    ИЗ
    |        Документ.ЧекККМ.Товары КАК ЧекККМТовары
    |    ГДЕ
    |        ЧекККМТовары.Ссылка.Дата МЕЖДУ &НачПериода И &КонПериода
    |        И ЧекККМТовары.Ссылка.Проведен
    |        И ЧекККМТовары.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЧекККМ.Продажа)
    |        И ЧекККМТовары.Ссылка.НомерЧекаККМ <> 0
    |    ОБЪЕДИНИТЬ ВСЕ
    |    ВЫБРАТЬ
    |        ЧекККМТовары.Ссылка.Дата,
    |        ЧекККМТовары.Ссылка.Склад,
    |        ЧекККМТовары.Номенклатура,
    |        -ЧекККМТовары.Количество,
    |        -(ЧекККМТовары.Сумма
    |          - ЧекККМТовары.СуммаСкидки
    |          - ЧекККМТовары.ОплатаПодарочнымиСертификатами
    |          - ЧекККМТовары.ОплатаБонусами),
    |        ""retail""
    |    ИЗ
    |        Документ.ЧекККМ.Товары КАК ЧекККМТовары
    |    ГДЕ
    |        ЧекККМТовары.Ссылка.Дата МЕЖДУ &НачПериода И &КонПериода
    |        И ЧекККМТовары.Ссылка.Проведен
    |        И ЧекККМТовары.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЧекККМ.Возврат)
    |    ОБЪЕДИНИТЬ ВСЕ
    |    ВЫБРАТЬ
    |        Прод.Период,
    |        Прод.Подразделение.Склад,
    |        Прод.Номенклатура,
    |        Прод.КоличествоОборот,
    |        Прод.СтоимостьОборот,
    |        ""corporate""
    |    ИЗ
    |        РегистрНакопления.Продажи.Обороты(&НачПериода, &КонПериода, Регистратор, ) КАК Прод
    |    ГДЕ
    |        Прод.Подразделение.Склад <> ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)
    |        И Прод.Номенклатура       <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
    |    ) КАК ВложенныйЗапрос
    |СГРУППИРОВАТЬ ПО
    |    ВложенныйЗапрос.Склад,
    |    ВложенныйЗапрос.Номенклатура,
    |    ВложенныйЗапрос.Склад.Код,
    |    ВложенныйЗапрос.Склад.Наименование,
    |    ВложенныйЗапрос.Номенклатура.Код,
    |    ВложенныйЗапрос.Номенклатура.Наименование,
    |    ВложенныйЗапрос.Номенклатура.НоменклатурнаяГруппа.Наименование,
    |    ВложенныйЗапрос.Источник";
    Запрос.УстановитьПараметр("НачПериода", НачПериода);
    Запрос.УстановитьПараметр("КонПериода", КонПериода);
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции


Функция _ПолучитьСебестоимость(НачПериода, КонПериода)
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |    Парт.Склад.Код              КАК СкладКод,
    |    Парт.Номенклатура.Код        КАК ТоварКод,
    |    СУММА(Парт.СтоимостьРасход)  КАК СуммаСебестоимости
    |ИЗ
    |    РегистрНакопления.ПартииТоваровНаСкладах.Обороты(
    |        &НачПериода, &КонПериода, Регистратор, ) КАК Парт
    |ГДЕ
    |    Парт.Склад <> ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)
    |    И Парт.Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
    |    И Парт.СтоимостьРасход > 0
    |    И ТИПЗНАЧЕНИЯ(Парт.Регистратор) В (
    |        ТИП(Документ.ЧекККМ),
    |        ТИП(Документ.РеализацияТоваровУслуг),
    |        ТИП(Документ.ВозвратТоваровОтПокупателя))
    |СГРУППИРОВАТЬ ПО
    |    Парт.Склад.Код, Парт.Номенклатура.Код";
    Запрос.УстановитьПараметр("НачПериода", НачПериода);
    Запрос.УстановитьПараметр("КонПериода", КонПериода);
    Попытка
        Возврат Запрос.Выполнить().Выгрузить();
    Исключение
        Возврат Новый ТаблицаЗначений;
    КонецПопытки;
КонецФункции


Функция _ПолучитьПланы(НачПериода)
    КонецМесяцаПлана = КонецДня(КонецМесяца(НачПериода));
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |    П.Подразделение.ф_Подразделение.Склад.Код          КАК СкладКод,
    |    П.Подразделение.ф_Подразделение.Склад.Наименование КАК СкладНаим,
    |    ""_total""                                          КАК ТоварКод,
    |    ""ИТОГО по магазину""                                КАК ТоварНаим,
    |    СУММА(П.ПланОборот)                                КАК СуммаПлана
    |ИЗ
    |    РегистрНакопления.ф_ПланФактПоПродавцам.Обороты(&НачПериода, &КонПериода, Авто, ) КАК П
    |ГДЕ
    |    П.ВидОперации = ЗНАЧЕНИЕ(Перечисление.фВидыОперацииУстановкиПланФактаПоПродавцам.СТС)
    |СГРУППИРОВАТЬ ПО
    |    П.Подразделение.ф_Подразделение.Склад.Код,
    |    П.Подразделение.ф_Подразделение.Склад.Наименование";
    Запрос.УстановитьПараметр("НачПериода", НачПериода);
    Запрос.УстановитьПараметр("КонПериода", КонецМесяцаПлана);
    Попытка
        Возврат Запрос.Выполнить().Выгрузить();
    Исключение
        Возврат Новый ТаблицаЗначений;
    КонецПопытки;
КонецФункции


Функция _ПолучитьСтатистикуЧеков(НачПериода, КонПериода)
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |    ЧекККМ.Склад.Код КАК СкладКод,
    |    КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЧекККМ.НомерЧекаККМ) КАК КоличествоЧеков,
    |    СУММА(ВЫБОР КОГДА ЧекККМ.ДисконтнаяКарта <> ЗНАЧЕНИЕ(Справочник.ДисконтныеКарты.ПустаяСсылка)
    |              ТОГДА 1 ИНАЧЕ 0 КОНЕЦ) КАК ЧековСКартой,
    |    СУММА(ЧекККМ.СуммаДокумента) КАК СуммаДок,
    |    СУММА(ЧекККМТовары.СуммаСкидки) КАК СуммаСкидкиВсего,
    |    СУММА(ЧекККМТовары.ОплатаПодарочнымиСертификатами) КАК ПодарочныеСе,
    |    СУММА(ЧекККМТовары.ОплатаБонусами) КАК Бонусы
    |ИЗ
    |    Документ.ЧекККМ КАК ЧекККМ
    |        ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЧекККМ.Товары КАК ЧекККМТовары
    |        ПО ЧекККМТовары.Ссылка = ЧекККМ.Ссылка
    |ГДЕ
    |    ЧекККМ.Дата МЕЖДУ &НачПериода И &КонПериода
    |    И ЧекККМ.Проведен
    |    И ЧекККМ.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЧекККМ.Продажа)
    |    И ЧекККМ.НомерЧекаККМ <> 0
    |СГРУППИРОВАТЬ ПО ЧекККМ.Склад.Код";
    Запрос.УстановитьПараметр("НачПериода", НачПериода);
    Запрос.УстановитьПараметр("КонПериода", КонПериода);
    Попытка
        Возврат Запрос.Выполнить().Выгрузить();
    Исключение
        Возврат Новый ТаблицаЗначений;
    КонецПопытки;
КонецФункции


Функция _СобратьМагазины(ТабПродажи, ТабПланы)
    Магазины = Новый Соответствие;
    Для Каждого Стр Из ТабПродажи Цикл
        Если ПустаяСтрока(Стр.СкладКод) Тогда Продолжить КонецЕсли;
        Если Магазины.Получить(Стр.СкладКод) = Неопределено Тогда
            Магазины.Вставить(Стр.СкладКод, Новый Структура("name,sources", Стр.СкладНаим, Новый Соответствие));
        КонецЕсли;
        Магазины[Стр.СкладКод].sources.Вставить(Стр.Источник, Истина);
    КонецЦикла;
    Для Каждого Стр Из ТабПланы Цикл
        Если ПустаяСтрока(Стр.СкладКод) Тогда Продолжить КонецЕсли;
        Если Магазины.Получить(Стр.СкладКод) = Неопределено Тогда
            Магазины.Вставить(Стр.СкладКод, Новый Структура("name,sources", Стр.СкладНаим, Новый Соответствие));
        КонецЕсли;
    КонецЦикла;
    Результат = Новый Массив;
    Для Каждого КЗ Из Магазины Цикл
        Источник = "";
        Розн = КЗ.Значение.sources.Получить("retail");
        Опт  = КЗ.Значение.sources.Получить("corporate");
        Если Розн = Истина И Опт = Истина Тогда Источник = "mixed";
        ИначеЕсли Розн = Истина Тогда Источник = "retail";
        ИначеЕсли Опт  = Истина Тогда Источник = "corporate";
        КонецЕсли;
        Формат = "";
        Попытка
            СпрСклад = Справочники.Склады.НайтиПоКоду(КЗ.Ключ);
            Если ЗначениеЗаполнено(СпрСклад) И СпрСклад.Метаданные().Реквизиты.Найти("ФорматМагазина") <> Неопределено Тогда
                Формат = "" + СпрСклад.ФорматМагазина;
            КонецЕсли;
        Исключение
            // ignore
        КонецПопытки;
        Результат.Добавить(Новый Структура("id,name,region,source,format",
            КЗ.Ключ, КЗ.Значение.name, "Иркутск", Источник, Формат));
    КонецЦикла;
    Возврат Результат;
КонецФункции


Функция _СобратьНоменклатуру(ТабПродажи)
    Товары = Новый Соответствие;
    Для Каждого Стр Из ТабПродажи Цикл
        Если ПустаяСтрока(Стр.ТоварКод) Тогда Продолжить КонецЕсли;
        Категория = Стр.Категория;
        Если ПустаяСтрока(Категория) Тогда Категория = "Прочее" КонецЕсли;
        Товары.Вставить(Стр.ТоварКод, Новый Структура("id,name,category",
            Стр.ТоварКод, Стр.ТоварНаим, Категория));
    КонецЦикла;
    Товары.Вставить("_total", Новый Структура("id,name,category",
        "_total", "ИТОГО по магазину", "План"));
    Результат = Новый Массив;
    Для Каждого КЗ Из Товары Цикл
        Результат.Добавить(КЗ.Значение);
    КонецЦикла;
    Возврат Результат;
КонецФункции


Функция _СформироватьПланы(ТабПланы)
    Результат = Новый Массив;
    Для Каждого Стр Из ТабПланы Цикл
        Если ПустаяСтрока(Стр.СкладКод) Или ПустаяСтрока(Стр.ТоварКод) Тогда Продолжить КонецЕсли;
        Результат.Добавить(Новый Структура("storeId,productId,amount",
            Стр.СкладКод, Стр.ТоварКод, Стр.СуммаПлана));
    КонецЦикла;
    Возврат Результат;
КонецФункции


Функция _СформироватьПродажи(ТабПродажи, ТабСебестоимость)
    КартаСебестоимости = Новый Соответствие;
    Для Каждого СС Из ТабСебестоимость Цикл
        Ключ = СС.СкладКод + "|" + СС.ТоварКод;
        КартаСебестоимости.Вставить(Ключ, СС.СуммаСебестоимости);
    КонецЦикла;
    Результат = Новый Массив;
    Для Каждого Стр Из ТабПродажи Цикл
        Если ПустаяСтрока(Стр.СкладКод) Или ПустаяСтрока(Стр.ТоварКод) Тогда Продолжить КонецЕсли;
        Если ЗначениеЗаполнено(Стр.ПоследняяДата) Тогда
            ДатаПродажи = Формат(Стр.ПоследняяДата, "ДФ=yyyy-MM-ddTHH:mm:ss") + "+08:00";
        Иначе
            ДатаПродажи = Формат(ТекущаяДата(), "ДФ=yyyy-MM-ddTHH:mm:ss") + "+08:00";
        КонецЕсли;
        Ключ = Стр.СкладКод + "|" + Стр.ТоварКод;
        Себест = КартаСебестоимости.Получить(Ключ);
        Если Себест = Неопределено Тогда Себест = 0 КонецЕсли;
        Результат.Добавить(Новый Структура("storeId,productId,amount,cost,quantity,soldAt",
            Стр.СкладКод, Стр.ТоварКод, Стр.Выручка, Себест, Стр.Количество, ДатаПродажи));
    КонецЦикла;
    Возврат Результат;
КонецФункции


Функция _СформироватьСтатистикуЧеков(ТабЧеки)
    Результат = Новый Массив;
    Для Каждого Стр Из ТабЧеки Цикл
        Если ПустаяСтрока(Стр.СкладКод) Тогда Продолжить КонецЕсли;
        Результат.Добавить(Новый Структура(
            "storeId,chequeCount,withCardCount,factSum,discountSum,paymentGift,paymentBonus",
            Стр.СкладКод, Стр.КоличествоЧеков, Стр.ЧековСКартой,
            Стр.СуммаДок, Стр.СуммаСкидкиВсего, Стр.ПодарочныеСе, Стр.Бонусы));
    КонецЦикла;
    Возврат Результат;
КонецФункции
