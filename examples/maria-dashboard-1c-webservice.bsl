////////////////////////////////////////////////////////////////////////////////
// HTTP-сервис: ДашбордПродажАПИ
// Конфигурация: Хлебобулочное и кондитерское производство 1.3 (на УПП)
//
// НАЗНАЧЕНИЕ
//   Универсальный HTTP-сервис для интеграции с дашбордом
//   sales-plan-dashboard.onrender.com. Даёт дашборду возможность
//   САМОСТОЯТЕЛЬНО тянуть данные из 1С (pull-режим), вместо ожидания
//   часового push'а.
//
// КАК ПОДКЛЮЧИТЬ В 1С
//   1. Конфигуратор → Общие → HTTP-сервисы → Добавить
//        Имя: ДашбордПродажАПИ
//        Корневой URL: dashboard
//   2. Добавить шаблоны URL и методы:
//
//      Шаблон URL: /pull
//        Метод GET → ВыполнитьPull
//        (выгружает данные за месяц — period=YYYY-MM)
//
//      Шаблон URL: /pull-range
//        Метод GET → ВыполнитьPullRange
//        (выгружает диапазон месяцев — from=YYYY-MM&to=YYYY-MM)
//
//      Шаблон URL: /meta
//        Метод GET → ВыполнитьMeta
//        (список всех объектов конфигурации)
//
//      Шаблон URL: /object
//        Метод GET → ВыполнитьObject
//        (структура объекта + sample — kind=...&name=...)
//
//      Шаблон URL: /register
//        Метод GET → ВыполнитьRegister
//        (обороты регистра — name=...&from=...&to=...)
//
//      Шаблон URL: /health
//        Метод GET → ВыполнитьHealth
//        (быстрая проверка живости)
//
//   3. Опубликовать на веб-сервере 1С:
//        Администрирование → Публикация на веб-сервере
//        Установить галку «HTTP-сервисы» → ДашбордПродажАПИ
//
//   4. Включить Basic Auth:
//        В Конфигураторе настроить пользователя «dashboard-api»
//        с правами «Только чтение» (роль из стандартного УПП).
//
//   5. Сообщить дашборду URL и креды через Render env:
//        UPP_PULL_URL=https://your-1c-server/UPP/hs/dashboard/pull
//        UPP_PULL_USER=dashboard-api
//        UPP_PULL_PASSWORD=...
//
// БЕЗОПАСНОСТЬ
//   Все методы — READ-ONLY (только GET-выборки из 1С). Никаких UPDATE/
//   DELETE/INSERT. Авторизация Basic Auth через пользователя с ролью
//   «Только чтение».
////////////////////////////////////////////////////////////////////////////////


// ─── ВСПОМОГАТЕЛЬНОЕ ─────────────────────────────────────────────────────────

Функция ОтветJSON(Данные, КодСостояния = 200)
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, Данные);
    Строка = ЗаписьJSON.Закрыть();

    Ответ = Новый HTTPСервисОтвет(КодСостояния);
    Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    Ответ.УстановитьТелоИзСтроки(Строка, КодировкаТекста.UTF8);
    Возврат Ответ;
КонецФункции


Функция ОтветОшибки(КодСостояния, Сообщение)
    Возврат ОтветJSON(Новый Структура("error", Сообщение), КодСостояния);
КонецФункции


Функция РазобратьПериодYYYY_MM(Стр)
    Если ТипЗнч(Стр) <> Тип("Строка") Или СтрДлина(Стр) <> 7 Или Сред(Стр, 5, 1) <> "-" Тогда
        Возврат Неопределено;
    КонецЕсли;
    Попытка
        Год = Число(Лев(Стр, 4));
        Месяц = Число(Прав(Стр, 2));
        Если Год < 2000 Или Месяц < 1 Или Месяц > 12 Тогда
            Возврат Неопределено;
        КонецЕсли;
        Возврат Дата(Год, Месяц, 1);
    Исключение
        Возврат Неопределено;
    КонецПопытки;
КонецФункции


// ─── /health ─────────────────────────────────────────────────────────────────
// Быстрая проверка что HTTP-сервис жив. Возвращает имя конфы и время сервера.
//
Функция ВыполнитьHealth(Запрос) Экспорт
    Возврат ОтветJSON(Новый Структура(
        "status,configuration,version,time",
        "ok",
        Метаданные.Имя,
        Метаданные.Версия,
        Формат(ТекущаяДата(), "ДФ=yyyy-MM-ddTHH:mm:ss")));
КонецФункции


// ─── /pull?period=YYYY-MM ────────────────────────────────────────────────────
// Возвращает payload для одного месяца — тот же формат что push:
// /api/ingest/upp на дашборде. Используется ежедневной (или ручной)
// синхронизацией текущего/прошлого месяца.
//
Функция ВыполнитьPull(Запрос) Экспорт

    Период = Запрос.ПараметрыЗапроса.Получить("period");
    Если ПустаяСтрока(Период) Тогда
        Период = Формат(НачалоМесяца(ТекущаяДата()), "ДФ=yyyy-MM");
    КонецЕсли;

    ПериодДата = РазобратьПериодYYYY_MM(Период);
    Если ПериодДата = Неопределено Тогда
        Возврат ОтветОшибки(400, "Некорректный period, ожидается YYYY-MM");
    КонецЕсли;

    НачПериода = НачалоМесяца(ПериодДата);
    КонПериода = КонецДня(КонецМесяца(ПериодДата));

    Возврат ОтветJSON(СобратьПакетЗаПериод(НачПериода, КонПериода, Период));

КонецФункции


// ─── /pull-range?from=YYYY-MM&to=YYYY-MM ─────────────────────────────────────
// Возвращает МАССИВ пакетов за несколько месяцев. Дашборд использует это
// для массовой исторической загрузки одним запросом (за неделю / квартал /
// 2 года).
//
// ВНИМАНИЕ: ответ может быть большим (10-50 МБ для 24 месяцев). Если у
// сервера 1С есть лимит на длину ответа — лучше использовать /pull
// в цикле.
//
Функция ВыполнитьPullRange(Запрос) Экспорт

    ОтДата = РазобратьПериодYYYY_MM(Запрос.ПараметрыЗапроса.Получить("from"));
    ДоДата = РазобратьПериодYYYY_MM(Запрос.ПараметрыЗапроса.Получить("to"));

    Если ОтДата = Неопределено Или ДоДата = Неопределено Тогда
        Возврат ОтветОшибки(400, "Параметры from и to обязательны, формат YYYY-MM");
    КонецЕсли;

    Если ОтДата > ДоДата Тогда
        Возврат ОтветОшибки(400, "from должен быть <= to");
    КонецЕсли;

    Пакеты = Новый Массив;
    Текущ = НачалоМесяца(ОтДата);
    Пока Текущ <= ДоДата Цикл
        НачП = Текущ;
        КонП = КонецДня(КонецМесяца(Текущ));
        Период = Формат(НачП, "ДФ=yyyy-MM");
        Попытка
            Пакеты.Добавить(СобратьПакетЗаПериод(НачП, КонП, Период));
        Исключение
            Пакеты.Добавить(Новый Структура("period,error", Период, "" + ОписаниеОшибки()));
        КонецПопытки;
        Текущ = ДобавитьМесяц(Текущ, 1);
    КонецЦикла;

    Возврат ОтветJSON(Новый Структура("packages", Пакеты));

КонецФункции


// ─── /meta ───────────────────────────────────────────────────────────────────
// Возвращает структуру всей конфигурации (~2172 объекта в УПП Марии).
// Лёгкая версия — только kind/name/synonym, без свойств.
//
Функция ВыполнитьMeta(Запрос) Экспорт

    Объекты = Новый Массив;
    Виды = Новый Структура;
    Виды.Вставить("РегистрНакопления", Метаданные.РегистрыНакопления);
    Виды.Вставить("РегистрСведений",  Метаданные.РегистрыСведений);
    Виды.Вставить("Документ",          Метаданные.Документы);
    Виды.Вставить("Справочник",        Метаданные.Справочники);
    Виды.Вставить("Перечисление",      Метаданные.Перечисления);
    Виды.Вставить("Отчет",             Метаданные.Отчеты);

    Для Каждого КЗ Из Виды Цикл
        Вид = КЗ.Ключ;
        Колл = КЗ.Значение;
        Для Каждого МД Из Колл Цикл
            Объекты.Добавить(Новый Структура(
                "kind,name,synonym",
                Вид, МД.Имя, МД.Синоним));
        КонецЦикла;
    КонецЦикла;

    Возврат ОтветJSON(Новый Структура(
        "configurationName,configurationVersion,snapshotAt,objects",
        Метаданные.Имя, Метаданные.Версия,
        Формат(ТекущаяДата(), "ДФ=yyyy-MM-ddTHH:mm:ss"),
        Объекты));

КонецФункции


// ─── /object?kind=...&name=... ───────────────────────────────────────────────
// Возвращает свойства объекта (для регистров — измерения/ресурсы/реквизиты,
// для документов — реквизиты + табличные части, для справочников — реквизиты).
// Без sample-данных (тяжело).
//
Функция ВыполнитьObject(Запрос) Экспорт

    Вид = Запрос.ПараметрыЗапроса.Получить("kind");
    Имя = Запрос.ПараметрыЗапроса.Получить("name");
    Если ПустаяСтрока(Вид) Или ПустаяСтрока(Имя) Тогда
        Возврат ОтветОшибки(400, "kind и name обязательны");
    КонецЕсли;

    Свойства = Новый Массив;
    МД = Неопределено;

    Если Вид = "РегистрНакопления" Тогда
        МД = Метаданные.РегистрыНакопления.Найти(Имя);
    ИначеЕсли Вид = "РегистрСведений" Тогда
        МД = Метаданные.РегистрыСведений.Найти(Имя);
    ИначеЕсли Вид = "Документ" Тогда
        МД = Метаданные.Документы.Найти(Имя);
    ИначеЕсли Вид = "Справочник" Тогда
        МД = Метаданные.Справочники.Найти(Имя);
    КонецЕсли;

    Если МД = Неопределено Тогда
        Возврат ОтветОшибки(404, "Объект " + Вид + "." + Имя + " не найден");
    КонецЕсли;

    Если Вид = "РегистрНакопления" Или Вид = "РегистрСведений" Тогда
        Для Каждого Изм Из МД.Измерения Цикл
            Свойства.Добавить(Новый Структура("kind,name,synonym,type", "Измерение", Изм.Имя, Изм.Синоним, "" + Изм.Тип));
        КонецЦикла;
        Для Каждого Рес Из МД.Ресурсы Цикл
            Свойства.Добавить(Новый Структура("kind,name,synonym,type", "Ресурс", Рес.Имя, Рес.Синоним, "" + Рес.Тип));
        КонецЦикла;
        Для Каждого Рек Из МД.Реквизиты Цикл
            Свойства.Добавить(Новый Структура("kind,name,synonym,type", "Реквизит", Рек.Имя, Рек.Синоним, "" + Рек.Тип));
        КонецЦикла;
    ИначеЕсли Вид = "Документ" Тогда
        Для Каждого Рек Из МД.Реквизиты Цикл
            Свойства.Добавить(Новый Структура("kind,name,synonym,type", "Реквизит", Рек.Имя, Рек.Синоним, "" + Рек.Тип));
        КонецЦикла;
        Для Каждого ТЧ Из МД.ТабличныеЧасти Цикл
            Свойства.Добавить(Новый Структура("kind,name,synonym,type", "ТабличнаяЧасть", ТЧ.Имя, ТЧ.Синоним, ""));
            Для Каждого Рек Из ТЧ.Реквизиты Цикл
                Свойства.Добавить(Новый Структура(
                    "kind,name,synonym,type",
                    "Реквизит", ТЧ.Имя + "." + Рек.Имя, Рек.Синоним, "" + Рек.Тип));
            КонецЦикла;
        КонецЦикла;
    ИначеЕсли Вид = "Справочник" Тогда
        Для Каждого Рек Из МД.Реквизиты Цикл
            Свойства.Добавить(Новый Структура("kind,name,synonym,type", "Реквизит", Рек.Имя, Рек.Синоним, "" + Рек.Тип));
        КонецЦикла;
    КонецЕсли;

    Возврат ОтветJSON(Новый Структура(
        "kind,name,synonym,properties",
        Вид, МД.Имя, МД.Синоним, Свойства));

КонецФункции


// ─── /document?name=...&from=...&to=...&limit=... ────────────────────────────
// Сырые поля любого документа за период (по полю Дата). Только Проведён.
//
Функция ВыполнитьDocument(Запрос) Экспорт

    Имя = Запрос.ПараметрыЗапроса.Получить("name");
    ОтДата = РазобратьПериодYYYY_MM(Запрос.ПараметрыЗапроса.Получить("from"));
    ДоДата = РазобратьПериодYYYY_MM(Запрос.ПараметрыЗапроса.Получить("to"));
    ЛимитСтр = Запрос.ПараметрыЗапроса.Получить("limit");
    Лимит = ?(ПустаяСтрока(ЛимитСтр), 500, Мин(Макс(Число(ЛимитСтр), 1), 5000));

    Если ПустаяСтрока(Имя) Тогда Возврат ОтветОшибки(400, "name обязателен"); КонецЕсли;
    Если ОтДата = Неопределено Или ДоДата = Неопределено Тогда
        Возврат ОтветОшибки(400, "from и to обязательны (YYYY-MM)");
    КонецЕсли;

    МД = Метаданные.Документы.Найти(Имя);
    Если МД = Неопределено Тогда Возврат ОтветОшибки(404, "Документ " + Имя + " не найден"); КонецЕсли;

    НачП = НачалоМесяца(ОтДата);
    КонП = КонецДня(КонецМесяца(ДоДата));

    Колонки = Новый Массив;
    Колонки.Добавить("Ссылка");
    Колонки.Добавить("Дата");
    Колонки.Добавить("Номер");
    Колонки.Добавить("Проведен");
    Для Каждого Рек Из МД.Реквизиты Цикл
        Колонки.Добавить(Рек.Имя);
    КонецЦикла;
    СтрПоля = "";
    Для Каждого К Из Колонки Цикл
        СтрПоля = СтрПоля + ?(СтрПоля = "", "", ", ") + "Д." + К;
    КонецЦикла;

    ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит, "ЧГ=") + " " + СтрПоля
        + " ИЗ Документ." + Имя + " КАК Д"
        + " ГДЕ Д.Дата МЕЖДУ &Н И &К И Д.Проведен";

    Запрос1С = Новый Запрос(ТекстЗапроса);
    Запрос1С.УстановитьПараметр("Н", НачП);
    Запрос1С.УстановитьПараметр("К", КонП);

    Попытка
        Таблица = Запрос1С.Выполнить().Выгрузить();
    Исключение
        Возврат ОтветОшибки(500, "Ошибка: " + ОписаниеОшибки());
    КонецПопытки;

    Строки = Новый Массив;
    Для Каждого Стр Из Таблица Цикл
        Зап = Новый Структура;
        Для Каждого К Из Колонки Цикл
            Зап.Вставить(К, "" + Стр[К]);
        КонецЦикла;
        Строки.Добавить(Зап);
    КонецЦикла;

    Возврат ОтветJSON(Новый Структура(
        "document,from,to,rowsCount,rows",
        Имя, Формат(НачП, "ДФ=yyyy-MM-dd"), Формат(КонП, "ДФ=yyyy-MM-dd"),
        Строки.Количество(), Строки));

КонецФункции


// ─── /sales-detail?period=YYYY-MM&limit=... ──────────────────────────────────
// Детальные строки розничных продаж с НомерЧекаККМ, ДисконтнаяКартой,
// полной разбивкой скидок и оплат. Для отчётов «средний чек по чекам»,
// «новые/постоянные клиенты» и т.д.
//
Функция ВыполнитьSalesDetail(Запрос) Экспорт
    Период = Запрос.ПараметрыЗапроса.Получить("period");
    ПериодДата = РазобратьПериодYYYY_MM(Период);
    Если ПериодДата = Неопределено Тогда Возврат ОтветОшибки(400, "period=YYYY-MM"); КонецЕсли;

    ЛимитСтр = Запрос.ПараметрыЗапроса.Получить("limit");
    Лимит = ?(ПустаяСтрока(ЛимитСтр), 50000, Мин(Макс(Число(ЛимитСтр), 1), 200000));

    НачП = НачалоМесяца(ПериодДата);
    КонП = КонецДня(КонецМесяца(ПериодДата));

    Запрос1С = Новый Запрос;
    Запрос1С.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит, "ЧГ=") + "
    |    ЧТ.Ссылка.Дата КАК Дата,
    |    ЧТ.Ссылка.Склад.Код КАК СкладКод,
    |    ЧТ.Ссылка.НомерЧекаККМ КАК НомерЧека,
    |    ЧТ.Ссылка.ВидОперации КАК ВидОперации,
    |    ВЫРАЗИТЬ(ЧТ.Ссылка.ДисконтнаяКарта.Код КАК СТРОКА(50)) КАК КартаКод,
    |    ЧТ.Номенклатура.Код КАК ТоварКод,
    |    ЧТ.Количество КАК Количество,
    |    ЧТ.Сумма КАК Сумма,
    |    ЧТ.СуммаСкидки КАК СуммаСкидки,
    |    ЧТ.ОплатаПодарочнымиСертификатами КАК ОплатаПодарочными,
    |    ЧТ.ОплатаБонусами КАК ОплатаБонусами,
    |    ЧТ.Цена КАК Цена
    |ИЗ
    |    Документ.ЧекККМ.Товары КАК ЧТ
    |ГДЕ
    |    ЧТ.Ссылка.Дата МЕЖДУ &Н И &К
    |    И ЧТ.Ссылка.Проведен
    |    И ЧТ.Ссылка.НомерЧекаККМ <> 0";
    Запрос1С.УстановитьПараметр("Н", НачП);
    Запрос1С.УстановитьПараметр("К", КонП);

    Попытка
        Таблица = Запрос1С.Выполнить().Выгрузить();
    Исключение
        Возврат ОтветОшибки(500, "Ошибка: " + ОписаниеОшибки());
    КонецПопытки;

    Строки = Новый Массив;
    Для Каждого Стр Из Таблица Цикл
        Строки.Добавить(Новый Структура(
            "date,storeCode,chequeNo,operation,cardCode,productCode,qty,sum,discount,payGift,payBonus,price",
            Формат(Стр.Дата, "ДФ=yyyy-MM-ddTHH:mm:ss") + "+08:00",
            "" + Стр.СкладКод, "" + Стр.НомерЧека, "" + Стр.ВидОперации,
            "" + Стр.КартаКод, "" + Стр.ТоварКод,
            Стр.Количество, Стр.Сумма, Стр.СуммаСкидки,
            Стр.ОплатаПодарочными, Стр.ОплатаБонусами, Стр.Цена));
    КонецЦикла;
    Возврат ОтветJSON(Новый Структура("period,rowsCount,rows",
        Период, Строки.Количество(), Строки));
КонецФункции


// ─── /products-detail?codes=A001,B002,...   (опц. или все) ───────────────────
// Расширенный справочник номенклатуры с весами, базовой единицей,
// номенклатурной группой. Для отчётов «продано в кг», «ценовые сегменты».
//
Функция ВыполнитьProductsDetail(Запрос) Экспорт
    ЛимитСтр = Запрос.ПараметрыЗапроса.Получить("limit");
