////////////////////////////////////////////////////////////////////////////////
// ДОБАВЛЕНИЕ к HTTP-сервису ДашбордПродажАПИ — для автоматизации
// планирования производства кондитерки (проект maria-prod-planning).
//
// READ-ONLY эндпоинты, которых не хватает текущему сервису:
//   0) /query          — УНИВЕРСАЛЬНЫЙ: любой запрос 1С (читает что угодно в базе).
//                        Покрывает /stock и /orders-detail как частные случаи —
//                        если ставите /query, узкие два можно НЕ ставить.
//   1) /stock          — остатки складов ГП/Запас/Контейнер (виртуальная Остатки())
//   2) /orders-detail  — позиции ЗаказПокупателя.Товары с ДатойОтгрузки (сайт + магазины)
//
// ───────────────────────────────────────────────────────────────────────────
// КАК ПОДКЛЮЧИТЬ (Hellstaff, в Конфигураторе):
//   1. Вставить функции ниже в модуль HTTP-сервиса ДашбордПродажАПИ
//      (туда же, где ВыполнитьRegister/ВыполнитьSalesDetail). НЕ в общий модуль.
//   2. Добавить шаблоны URL:
//        Шаблон URL: /query          Метод GET → ВыполнитьQuery
//        Шаблон URL: /query          Метод POST → ВыполнитьQuery   (тот же обработчик)
//        Шаблон URL: /stock          Метод GET → ВыполнитьStock
//        Шаблон URL: /orders-detail  Метод GET → ВыполнитьOrdersDetail
//   3. Опубликовать. Авторизация та же (Basic web/web, роль «Только чтение»).
//
// БЕЗОПАСНОСТЬ /query: язык запросов 1С физически только ЧИТАЕТ (нельзя UPDATE/
// DELETE/INSERT). Обработчик дополнительно: (а) принимает только текст,
// начинающийся с ВЫБРАТЬ; (б) принудительно ограничивает число отдаваемых
// строк (limit, потолок 10000); (в) выполняется под ролью «Только чтение».
// Это широкий доступ на ЧТЕНИЕ всех данных базы — держать за whitelist'ом.
////////////////////////////////////////////////////////////////////////////////


// ─── /query  (GET ?q=... | POST тело=текст запроса) ─────────────────────────
// Универсальная read-only выборка. Возвращает строки результата запроса 1С.
// Параметры (все опциональны кроме текста запроса):
//   q       — текст запроса (для GET); для POST — текст в теле запроса
//   limit   — потолок отдаваемых строк (по умолч. 5000, макс. 10000)
//   from,to — если заданы (YYYY-MM-DD), биндятся как &Н и &К (КонецДня для to)
//   date    — если задан (YYYY-MM-DD), биндится как &НаМомент (КонецДня)
// Пример: /query?q=ВЫБРАТЬ ПЕРВЫЕ 5 Код,Наименование ИЗ Справочник.Склады
//
// Ответ: { rowsCount, columns:[...], rows:[{...}, ...] }
//
Функция ВыполнитьQuery(Запрос) Экспорт

    // Текст запроса: из тела (POST) либо из параметра q (GET)
    ТекстЗапроса = "";
    Попытка
        ТелоСтр = Запрос.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
    Исключение
        ТелоСтр = "";
    КонецПопытки;
    Если НЕ ПустаяСтрока(ТелоСтр) Тогда
        ТекстЗапроса = ТелоСтр;
    Иначе
        ТекстЗапроса = "" + Запрос.ПараметрыЗапроса.Получить("q");
    КонецЕсли;
    ТекстЗапроса = СокрЛП(ТекстЗапроса);

    Если ПустаяСтрока(ТекстЗапроса) Тогда
        Возврат ОтветОшибки(400, "пустой запрос (передайте q= или тело POST)");
    КонецЕсли;

    // Защита: только выборки. ВРег чтобы поймать регистр/регистронезависимо.
    Нач7 = ВРег(Лев(СокрЛП(ТекстЗапроса), 7));
    Если Нач7 <> "ВЫБРАТЬ" Тогда
        Возврат ОтветОшибки(400, "разрешён только запрос, начинающийся с ВЫБРАТЬ");
    КонецЕсли;

    ЛимитСтр = Запрос.ПараметрыЗапроса.Получить("limit");
    Лимит = ?(ПустаяСтрока(ЛимитСтр), 5000, Мин(Макс(Число(ЛимитСтр), 1), 10000));

    Зап1С = Новый Запрос(ТекстЗапроса);

    // Опциональные стандартные параметры (если запрос их использует)
    ОтД = РазобратьДатуYYYY_MM_DD(Запрос.ПараметрыЗапроса.Получить("from"));
    ДоД = РазобратьДатуYYYY_MM_DD(Запрос.ПараметрыЗапроса.Получить("to"));
    НаД = РазобратьДатуYYYY_MM_DD(Запрос.ПараметрыЗапроса.Получить("date"));
    Если ОтД <> Неопределено Тогда Зап1С.УстановитьПараметр("Н", НачалоДня(ОтД)); КонецЕсли;
    Если ДоД <> Неопределено Тогда Зап1С.УстановитьПараметр("К", КонецДня(ДоД)); КонецЕсли;
    Если НаД <> Неопределено Тогда Зап1С.УстановитьПараметр("НаМомент", КонецДня(НаД)); КонецЕсли;

    Попытка
        Результат = Зап1С.Выполнить();
    Исключение
        Возврат ОтветОшибки(500, "Ошибка запроса: " + ОписаниеОшибки());
    КонецПопытки;

    // Имена колонок
    Колонки = Новый Массив;
    Для Каждого Кол Из Результат.Колонки Цикл
        Колонки.Добавить(Кол.Имя);
    КонецЦикла;

    // Чтение с принудительным потолком строк (не материализуем всё)
    Строки = Новый Массив;
    Выборка = Результат.Выбрать();
    Счётчик = 0;
    Пока Выборка.Следующий() И Счётчик < Лимит Цикл
        Зап = Новый Структура;
        Для Каждого ИмяКол Из Колонки Цикл
            Зап.Вставить(ИмяКол, "" + Выборка[ИмяКол]);
        КонецЦикла;
        Строки.Добавить(Зап);
        Счётчик = Счётчик + 1;
    КонецЦикла;

    Возврат ОтветJSON(Новый Структура("rowsCount,columns,rows",
        Строки.Количество(), Колонки, Строки));

КонецФункции


// ─── ВСПОМОГАТЕЛЬНОЕ: разбор даты YYYY-MM-DD ────────────────────────────────
// (РазобратьПериодYYYY_MM уже есть в сервисе — это его «дневной» аналог)
//
Функция РазобратьДатуYYYY_MM_DD(Стр)
    Если ТипЗнч(Стр) <> Тип("Строка") Или СтрДлина(Стр) <> 10
        Или Сред(Стр, 5, 1) <> "-" Или Сред(Стр, 8, 1) <> "-" Тогда
        Возврат Неопределено;
    КонецЕсли;
    Попытка
        Год = Число(Лев(Стр, 4));
        Месяц = Число(Сред(Стр, 6, 2));
        День = Число(Прав(Стр, 2));
        Возврат Дата(Год, Месяц, День);
    Исключение
        Возврат Неопределено;
    КонецПопытки;
КонецФункции


// ─── /stock?date=YYYY-MM-DD&warehouses=code1,code2,... ──────────────────────
// Остатки готовой продукции по складам на конец указанного дня (или текущие,
// если date не задан). По умолчанию — три склада планирования:
//   А00000011 «Склад готовой продукции»  → лист ГП
//   А00000046 «Склад запаса ГП»          → лист Запас
//   А00000155 «Склад контейнер»          → лист Контейнер
//
// Ответ: { date, rowsCount, rows:[{code,name,warehouseCode,warehouse,qty}, ...] }
//
Функция ВыполнитьStock(Запрос) Экспорт

    ДатаСтр = Запрос.ПараметрыЗапроса.Получить("date");
    НаМомент = Неопределено; // Неопределено = текущие остатки
    Если НЕ ПустаяСтрока(ДатаСтр) Тогда
        Д = РазобратьДатуYYYY_MM_DD(ДатаСтр);
        Если Д = Неопределено Тогда Возврат ОтветОшибки(400, "date=YYYY-MM-DD"); КонецЕсли;
        НаМомент = КонецДня(Д);
    КонецЕсли;

    // Список кодов складов
    КодыСтр = Запрос.ПараметрыЗапроса.Получить("warehouses");
    Если ПустаяСтрока(КодыСтр) Тогда
        КодыСтр = "А00000011,А00000046,А00000155";
    КонецЕсли;
    Коды = СтрРазделить(КодыСтр, ",", Ложь);

    Склады = Новый Массив;
    Для Каждого Код Из Коды Цикл
        К = СокрЛП(Код);
        Если ПустаяСтрока(К) Тогда Продолжить; КонецЕсли;
        СсылкаСклад = Справочники.Склады.НайтиПоКоду(К);
        Если ЗначениеЗаполнено(СсылкаСклад) Тогда
            Склады.Добавить(СсылкаСклад);
        КонецЕсли;
    КонецЦикла;
    Если Склады.Количество() = 0 Тогда
        Возврат ОтветОшибки(404, "ни один склад не найден по кодам: " + КодыСтр);
    КонецЕсли;

    Запрос1С = Новый Запрос;
    Запрос1С.Текст =
    "ВЫБРАТЬ
    |    Ост.Номенклатура.Код КАК Код,
    |    Ост.Номенклатура.Наименование КАК Имя,
    |    Ост.Склад.Код КАК СкладКод,
    |    Ост.Склад.Наименование КАК СкладИмя,
    |    Ост.КоличествоОстаток КАК Количество
    |ИЗ
    |    РегистрНакопления.ТоварыНаСкладах.Остатки(&НаМомент, Склад В (&Склады)) КАК Ост
    |ГДЕ
    |    Ост.КоличествоОстаток <> 0";
    Запрос1С.УстановитьПараметр("НаМомент", НаМомент);
    Запрос1С.УстановитьПараметр("Склады", Склады);

    Попытка
        Таблица = Запрос1С.Выполнить().Выгрузить();
    Исключение
        Возврат ОтветОшибки(500, "Ошибка запроса остатков: " + ОписаниеОшибки());
    КонецПопытки;

    Строки = Новый Массив;
    Для Каждого Стр Из Таблица Цикл
        Строки.Добавить(Новый Структура(
            "code,name,warehouseCode,warehouse,qty",
            "" + Стр.Код, "" + Стр.Имя,
            "" + Стр.СкладКод, "" + Стр.СкладИмя,
            Стр.Количество));
    КонецЦикла;

    Возврат ОтветJSON(Новый Структура("date,rowsCount,rows",
        ?(НаМомент = Неопределено, "now", Формат(НаМомент, "ДФ=yyyy-MM-dd")),
        Строки.Количество(), Строки));

КонецФункции


// ─── /orders-detail?from=YYYY-MM-DD&to=YYYY-MM-DD&limit=... ─────────────────
// Позиции заказов покупателей (ЗаказПокупателя.Товары), отфильтрованные по
// ДАТЕ ОТГРУЗКИ в диапазоне [from..to]. Покрывает и сайт-заказы (isSite=true,
// листы «Завтра/Послезавтра сайт»), и заказы магазинов для пресс-сетки
// (isSite=false; робот сам усредняет за 3 недели → листы стс/Выходные).
//
// Ответ: { from, to, rowsCount, rows:[{
//   productCode, productName, qty, shipDate, warehouseCode, counterparty, isSite }, ...] }
//
Функция ВыполнитьOrdersDetail(Запрос) Экспорт

    ОтД = РазобратьДатуYYYY_MM_DD(Запрос.ПараметрыЗапроса.Получить("from"));
    ДоД = РазобратьДатуYYYY_MM_DD(Запрос.ПараметрыЗапроса.Получить("to"));
    Если ОтД = Неопределено Или ДоД = Неопределено Тогда
        Возврат ОтветОшибки(400, "from и to обязательны (YYYY-MM-DD), фильтр по ДатаОтгрузки");
    КонецЕсли;

    ЛимитСтр = Запрос.ПараметрыЗапроса.Получить("limit");
    Лимит = ?(ПустаяСтрока(ЛимитСтр), 10000, Мин(Макс(Число(ЛимитСтр), 1), 10000));

    НачП = НачалоДня(ОтД);
    КонП = КонецДня(ДоД);

    Запрос1С = Новый Запрос;
    Запрос1С.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит, "ЧГ=") + "
    |    Т.Номенклатура.Код КАК ТоварКод,
    |    Т.Номенклатура.Наименование КАК ТоварИмя,
    |    Т.Количество КАК Количество,
    |    Т.Ссылка.ДатаОтгрузки КАК ДатаОтгрузки,
    |    ВЫРАЗИТЬ(Т.Ссылка.Склад.Код КАК СТРОКА(20)) КАК СкладКод,
    |    ВЫРАЗИТЬ(Т.Ссылка.Контрагент.Наименование КАК СТРОКА(150)) КАК Контрагент,
    |    Т.Ссылка.Сайт КАК Сайт
    |ИЗ
    |    Документ.ЗаказПокупателя.Товары КАК Т
    |ГДЕ
    |    Т.Ссылка.ДатаОтгрузки МЕЖДУ &Н И &К
    |    И Т.Ссылка.Проведен
    |    И Т.Количество <> 0
    |УПОРЯДОЧИТЬ ПО ДатаОтгрузки";
    Запрос1С.УстановитьПараметр("Н", НачП);
    Запрос1С.УстановитьПараметр("К", КонП);

    Попытка
        Таблица = Запрос1С.Выполнить().Выгрузить();
    Исключение
        Возврат ОтветОшибки(500, "Ошибка запроса заказов: " + ОписаниеОшибки());
    КонецПопытки;

    Строки = Новый Массив;
    Для Каждого Стр Из Таблица Цикл
        Строки.Добавить(Новый Структура(
            "productCode,productName,qty,shipDate,warehouseCode,counterparty,isSite",
            "" + Стр.ТоварКод, "" + Стр.ТоварИмя, Стр.Количество,
            Формат(Стр.ДатаОтгрузки, "ДФ=yyyy-MM-dd"),
            "" + Стр.СкладКод, "" + Стр.Контрагент,
            (Стр.Сайт = Истина)));
    КонецЦикла;

    Возврат ОтветJSON(Новый Структура("from,to,rowsCount,rows",
        Формат(НачП, "ДФ=yyyy-MM-dd"), Формат(КонП, "ДФ=yyyy-MM-dd"),
        Строки.Количество(), Строки));

КонецФункции
