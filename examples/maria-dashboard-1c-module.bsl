Процедура ДобавитьСампл(Объекты, Вид, Имя, ТекстЗапроса, Н, К)
    Попытка
        Запрос = Новый Запрос(ТекстЗапроса);
        Запрос.УстановитьПараметр("Н", Н);
        Запрос.УстановитьПараметр("К", К);
        Таблица = Запрос.Выполнить().Выгрузить();
        Sample = Новый Массив;
        Для Каждого Стр Из Таблица Цикл
            Запись = Новый Структура;
            Для Каждого Кол Из Таблица.Колонки Цикл
                Запись.Вставить(Кол.Имя, "" + Стр[Кол.Имя]);
            КонецЦикла;
            Sample.Добавить(Запись);
        КонецЦикла;
        Для Каждого Об Из Объекты Цикл
            Если Об.kind = Вид И Об.name = Имя Тогда
                Об.Вставить("sample", Sample);
                Прервать;
            КонецЕсли;
        КонецЦикла;
    Исключение
        Сообщить("Sample [" + Имя + "] пропущен: " + ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры
