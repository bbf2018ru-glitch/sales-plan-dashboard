////////////////////////////////////////////////////////////////////////////////
// Модуль: ДашбордПродаж
// Конфигурация: Хлебобулочное и кондитерское производство 1.3 (ФОРУС, на УПП)
//
// Назначение: отправка данных продаж и планов из 1С УПП в дашборд
//             https://sales-plan-dashboard.onrender.com
//
// Запуск: через Регламентное задание раз в час.
//
// ВЕРСИЯ ОТ 08.05.2026 — ОБНОВЛЕНА. Заменить старый модуль целиком на этот.
//
// Изменения относительно версии 07.05.2026:
//   • ПолучитьСебестоимость переписана на РегистрНакопления.ПартииТоваровНаСкладах
//     (управленческий учёт). Этот регистр содержит партии товаров на ВСЕХ складах,
//     включая розничные точки. Через виртуальную таблицу .Обороты(...) берём
//     СтоимостьРасход — это сумма себестоимости списанного товара за период.
//
//     Почему было неправильно: использовали ПродажиСебестоимость, в котором
//     розничных магазинов нет вообще (только опт, агрегаторы, служебные).
//     Это подтвердила диагностика регистра — все 50 sample-строк были именно
//     по этим подразделениям.
//
//   • В диагностику добавлены sample для ПартииТоваровНаСкладах,
//     УчетПродажИСебестоимости, ТоварыВРознице — для дальнейшего анализа.
//
// Изменения относительно версии 05.05.2026:
//   • Убрано условие "Если Час = 0" перед вызовом ВыгрузитьДиагностикуВДашборд().
//     Регламентное задание Марии работает с 7:00 до 23:00 — час 0 в это окно
//     не попадает, поэтому диагностика никогда не запускалась.
//     Теперь диагностика отправляется при КАЖДОЙ выгрузке (раз в час).
//     Дашборд хранит только последние 10 снимков, старые удаляются.
//
// Полный список 4 правок от первоначального модуля Hellstaff'а:
//   1. План берётся за ВЕСЬ месяц, а не до текущей даты
//      (было: накопительный, на 4 мая видим 4/31 от месячного — баг)
//   2. Себестоимость берётся из РегистрНакопления.ПродажиСебестоимость
//      → дашборд начнёт показывать маржу
//   3. Поле "source" у магазина: retail / corporate / mixed
//      → дашборд покажет бейдж типа точки рядом с именем
//   4. Процедура ВыгрузитьДиагностикуВДашборд() — шлёт полный снимок структуры
//      конфигурации (метаданные + sample ключевых регистров) при каждой
//      выгрузке. Дашборд показывает в /admin/upp-explorer.html
//      → разработчик дашборда видит структуру 1С без беспокойства
////////////////////////////////////////////////////////////////////////////////


// ─── ТОЧКА ВХОДА ──────────────────────────────────────────────────────────────
Процедура ВыполнитьВыгрузкуВДашборд() Экспорт

    ВыгрузитьПериодВДашборд(НачалоМесяца(ТекущаяДата()), КонецДня(ТекущаяДата()), Ложь);

КонецПроцедуры


// ─── МАССОВАЯ ИСТОРИЧЕСКАЯ ВЫГРУЗКА ──────────────────────────────────────────
// Загружает в дашборд последние 24 месяца (по одному пакету на месяц).
// Запускать ОДИН РАЗ из консоли 1С — после этого дашборд получит полную
// историю и сможет показывать L2L (этот год vs прошлый), тренд по 24 месяцам,
// новые позиции и т.д.
//
// Запуск из консоли 1С (Сервис → Обработка → Консоль запросов или Управляемая консоль):
//   ДашбордПродаж.ВыгрузитьИсторию24Месяца();
//
// Время выполнения: ~10-30 минут (24 запроса к БД + 24 HTTP POST).
//
Процедура ВыгрузитьИсторию24Месяца() Экспорт

    Сообщить("─── Старт исторической выгрузки 24 месяцев ───");

    // Идём от самого старого (24 месяца назад) к самому новому,
    // чтобы дашборд получал хронологически правильную последовательность.
    Для Смещение = 1 По 24 Цикл
        НомерМесяцаНазад = 25 - Смещение;  // 24, 23, ..., 1
        ДатаМесяца = ДобавитьМесяц(НачалоМесяца(ТекущаяДата()), -НомерМесяцаНазад);
        НачДата    = НачалоМесяца(ДатаМесяца);
        КонДата    = КонецДня(КонецМесяца(ДатаМесяца));
        Сообщить(">>> Месяц −" + НомерМесяцаНазад + ": " + Формат(НачДата, "ДФ=yyyy-MM"));
        Попытка
            ВыгрузитьПериодВДашборд(НачДата, КонДата, Истина);
        Исключение
            Сообщить("    Ошибка: " + ОписаниеОшибки());
        КонецПопытки;
    КонецЦикла;

    Сообщить("─── Готово. Все 24 месяца отправлены ───");

КонецПроцедуры


// ─── УНИВЕРСАЛЬНАЯ ВЫГРУЗКА ЗА ПЕРИОД ────────────────────────────────────────
// Используется и ежечасным регламентом (ВыполнитьВыгрузкуВДашборд),
// и исторической выгрузкой (ВыгрузитьИсторию24Месяца).
//
Процедура ВыгрузитьПериодВДашборд(НачалоМесяца, КонецПериода, ИсторическийРежим) Экспорт

    Хост   = "sales-plan-dashboard.onrender.com";
    Порт   = 443;
    Путь   = "/api/ingest/upp";
    ApiKey = "85307b26064e3764b0b19ce3223353057b0fe754b31f0f3a";

    Период       = Формат(НачалоМесяца, "ДФ=yyyy-MM");
    ИдПакета     = "maria-" + Период + "-" + Формат(ТекущаяДата(), "ДФ=yyyyMMdd-HHmmss");

    РезПродажи       = ПолучитьПродажи(НачалоМесяца, КонецПериода);
    РезСебестоимость = ПолучитьСебестоимость(НачалоМесяца, КонецПериода);
    РезПланы         = ПолучитьПланы(НачалоМесяца);
    РезЧеки          = ПолучитьСтатистикуЧеков(НачалоМесяца, КонецПериода);

    Пакет = Новый Структура;
    Пакет.Вставить("sourceSystem",     "1c-upp");
    Пакет.Вставить("sourceObject",     "sales_exchange");
    Пакет.Вставить("packageId",        ИдПакета);
    Пакет.Вставить("period",           Период);
    Пакет.Вставить("stores",           СобратьМагазины(РезПродажи, РезПланы));
    Пакет.Вставить("products",         СобратьНоменклатуру(РезПродажи));
    Пакет.Вставить("plans",            СформироватьПланы(РезПланы));
    Пакет.Вставить("sales",            СформироватьПродажи(РезПродажи, РезСебестоимость));
    Пакет.Вставить("cheques",          СформироватьСтатистикуЧеков(РезЧеки));
    Пакет.Вставить("marketingMetrics", Новый Массив);

    JSONСтрока = СериализоватьJSON(Пакет);
    Ответ      = ОтправитьPOST(Хост, Порт, Путь, ApiKey, JSONСтрока);
    Сообщить("Дашборд [" + Период + "]: " + Ответ);

    // Диагностика конфигурации шлётся ТОЛЬКО при обычной (текущей) выгрузке.
    // При исторической не шлём — она дублирует одни и те же метаданные 24 раза.
    Если НЕ ИсторическийРежим Тогда
        Попытка
            ВыгрузитьДиагностикуВДашборд();
        Исключение
            Сообщить("Диагностика 1С не отправлена: " + ОписаниеОшибки());
        КонецПопытки;
    КонецЕсли;

КонецПроцедуры


// ─── ЗАПРОС ПРОДАЖ ────────────────────────────────────────────────────────────
// Два потока:
//   1) Розница — из Документ.ЧекККМ.Товары (источник = "retail")
//   2) Опт/упр.учёт — из РегистрНакопления.Продажи через Подразделение.Склад
//      (источник = "corporate")
//
Функция ПолучитьПродажи(НачПериода, КонПериода)

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |    ВложенныйЗапрос.Склад.Код                                         КАК СкладКод,
    |    ВложенныйЗапрос.Склад.Наименование                                КАК СкладНаим,
    |    ВложенныйЗапрос.Номенклатура.Код                                  КАК ТоварКод,
    |    ВложенныйЗапрос.Номенклатура.Наименование                         КАК ТоварНаим,
    |    ВложенныйЗапрос.Номенклатура.НоменклатурнаяГруппа.Наименование    КАК Категория,
    |    ВложенныйЗапрос.Источник                                          КАК Источник,
    |    СУММА(ВложенныйЗапрос.Количество)                                 КАК Количество,
    |    СУММА(ВложенныйЗапрос.Сумма)                                      КАК Выручка,
    |    МАКСИМУМ(ВложенныйЗапрос.Период)                                  КАК ПоследняяДата
    |ИЗ
    |    (ВЫБРАТЬ
    |        ЧекККМТовары.Ссылка.Дата                                      КАК Период,
    |        ЧекККМТовары.Ссылка.Склад                                     КАК Склад,
    |        ЧекККМТовары.Номенклатура                                     КАК Номенклатура,
    |        ЧекККМТовары.Количество                                       КАК Количество,
    |        ЧекККМТовары.Сумма
    |          - ЧекККМТовары.СуммаСкидки
    |          - ЧекККМТовары.ОплатаПодарочнымиСертификатами
    |          - ЧекККМТовары.ОплатаБонусами                               КАК Сумма,
    |        ""retail""                                                    КАК Источник
    |    ИЗ
    |        Документ.ЧекККМ.Товары КАК ЧекККМТовары
    |    ГДЕ
    |        ЧекККМТовары.Ссылка.Дата МЕЖДУ &НачПериода И &КонПериода
    |        И ЧекККМТовары.Ссылка.Проведен
    |        И ЧекККМТовары.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЧекККМ.Продажа)
    |        И ЧекККМТовары.Ссылка.НомерЧекаККМ <> 0
    |
    |    ОБЪЕДИНИТЬ ВСЕ
    |
    |    ВЫБРАТЬ
    |        ЧекККМТовары.Ссылка.Дата,
    |        ЧекККМТовары.Ссылка.Склад,
    |        ЧекККМТовары.Номенклатура,
    |        -ЧекККМТовары.Количество,
    |        -(ЧекККМТовары.Сумма
    |          - ЧекККМТовары.СуммаСкидки
    |          - ЧекККМТовары.ОплатаПодарочнымиСертификатами
    |          - ЧекККМТовары.ОплатаБонусами),
    |        ""retail""
    |    ИЗ
    |        Документ.ЧекККМ.Товары КАК ЧекККМТовары
    |    ГДЕ
    |        ЧекККМТовары.Ссылка.Дата МЕЖДУ &НачПериода И &КонПериода
    |        И ЧекККМТовары.Ссылка.Проведен
    |        И ЧекККМТовары.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЧекККМ.Возврат)
    |
    |    ОБЪЕДИНИТЬ ВСЕ
    |
    |    ВЫБРАТЬ
    |        Прод.Период,
    |        Прод.Подразделение.Склад,
    |        Прод.Номенклатура,
    |        Прод.КоличествоОборот,
    |        Прод.СтоимостьОборот,
    |        ""corporate""
    |    ИЗ
    |        РегистрНакопления.Продажи.Обороты(&НачПериода, &КонПериода, Регистратор, ) КАК Прод
    |    ГДЕ
    |        Прод.Подразделение.Склад <> ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)
    |        И Прод.Номенклатура       <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
    |    ) КАК ВложенныйЗапрос
    |
    |СГРУППИРОВАТЬ ПО
    |    ВложенныйЗапрос.Склад,
    |    ВложенныйЗапрос.Номенклатура,
    |    ВложенныйЗапрос.Склад.Код,
    |    ВложенныйЗапрос.Склад.Наименование,
    |    ВложенныйЗапрос.Номенклатура.Код,
    |    ВложенныйЗапрос.Номенклатура.Наименование,
    |    ВложенныйЗапрос.Номенклатура.НоменклатурнаяГруппа.Наименование,
    |    ВложенныйЗапрос.Источник";

    Запрос.УстановитьПараметр("НачПериода", НачПериода);
    Запрос.УстановитьПараметр("КонПериода", КонПериода);
    Возврат Запрос.Выполнить().Выгрузить();

КонецФункции


// ─── ЗАПРОС СЕБЕСТОИМОСТИ ─────────────────────────────────────────────────────
// Источник: РегистрНакопления.ПартииТоваровНаСкладах (управленческий учёт).
// У этого регистра:
//   • измерение Склад прямо (а не через Подразделение)
//   • ресурс Стоимость
// Через виртуальную таблицу .Обороты получаем СтоимостьРасход — это сумма
// себестоимости товаров, списанных со склада за период (продажи + списания
// брака + перемещения, в большинстве 95%+ это именно продажи).
//
// Почему НЕ ПродажиСебестоимость: в этом регистре только опт/агрегаторы/
// служебные подразделения. Розничные магазины (Сезон, Ядринцева и т.д.)
// в нём отсутствуют — диагностика это подтвердила.
//
// Возвращает таблицу: СкладКод, ТоварКод, СуммаСебестоимости.
// В СформироватьПродажи() мерджится по ключу СкладКод+ТоварКод.
//
Функция ПолучитьСебестоимость(НачПериода, КонПериода)

    // Фильтр по типу регистратора — берём только продающие документы.
    // Без этого фильтра СтоимостьРасход включает списания брака,
    // перемещения между складами, дегустации и т.д. — это и давало
    // ~+1 млн ₽ лишней себестоимости и заниженную маржу относительно
    // отчёта «Валовая прибыль».
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |    Парт.Склад.Код              КАК СкладКод,
    |    Парт.Номенклатура.Код        КАК ТоварКод,
    |    СУММА(Парт.СтоимостьРасход)  КАК СуммаСебестоимости
    |ИЗ
    |    РегистрНакопления.ПартииТоваровНаСкладах.Обороты(
    |        &НачПериода, &КонПериода, Регистратор, ) КАК Парт
    |ГДЕ
    |    Парт.Склад <> ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)
    |    И Парт.Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
    |    И Парт.СтоимостьРасход > 0
    |    И ТИПЗНАЧЕНИЯ(Парт.Регистратор) В (
    |        ТИП(Документ.ЧекККМ),
    |        ТИП(Документ.РеализацияТоваровУслуг),
    |        ТИП(Документ.ВозвратТоваровОтПокупателя),
    |        ТИП(Документ.ОтчетОРозничныхПродажах))
    |СГРУППИРОВАТЬ ПО
    |    Парт.Склад.Код,
    |    Парт.Номенклатура.Код";

    Запрос.УстановитьПараметр("НачПериода", НачПериода);
    Запрос.УстановитьПараметр("КонПериода", КонПериода);

    Попытка
        Результат = Запрос.Выполнить().Выгрузить();
        Сообщить("Себестоимость: получено " + Результат.Количество() + " строк из ПартииТоваровНаСкладах");
        Возврат Результат;
    Исключение
        Сообщить("Себестоимость не получена: " + ОписаниеОшибки() + " — отправляем без маржи.");
        Возврат Новый ТаблицаЗначений;
    КонецПопытки;

КонецФункции


// ─── ЗАПРОС ПЛАНА ─────────────────────────────────────────────────────────────
// План берётся за ВЕСЬ месяц (от НачПериода до КонецМесяца(НачПериода)).
// Регистр ф_ПланФактПоПродавцам хранит план отдельной строкой на каждый день
// (через табличную часть «План факт» с реквизитом «Номер дня» в документе
// ф_УстановкаПланФактаПоПродавцам). Если запрашивать обороты только до
// текущей даты — придёт частичный план (4/31 от месячного на 4-е число
// месяца). Поэтому передаём полный месяц всегда.
//
Функция ПолучитьПланы(НачПериода)

    КонецМесяцаПлана = КонецДня(КонецМесяца(НачПериода));

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |    П.Подразделение.ф_Подразделение.Склад.Код          КАК СкладКод,
    |    П.Подразделение.ф_Подразделение.Склад.Наименование КАК СкладНаим,
    |    ""_total""                                          КАК ТоварКод,
    |    ""ИТОГО по магазину""                                КАК ТоварНаим,
    |    СУММА(П.ПланОборот)                                КАК СуммаПлана
    |ИЗ
    |    РегистрНакопления.ф_ПланФактПоПродавцам.Обороты(&НачПериода, &КонПериода, Авто, ) КАК П
    |ГДЕ
    |    П.ВидОперации = ЗНАЧЕНИЕ(Перечисление.фВидыОперацииУстановкиПланФактаПоПродавцам.СТС)
    |СГРУППИРОВАТЬ ПО
    |    П.Подразделение.ф_Подразделение.Склад.Код,
    |    П.Подразделение.ф_Подразделение.Склад.Наименование";

    Запрос.УстановитьПараметр("НачПериода", НачПериода);
    Запрос.УстановитьПараметр("КонПериода", КонецМесяцаПлана);

    Попытка
        Возврат Запрос.Выполнить().Выгрузить();
    Исключение
        Сообщить("Планы не получены: " + ОписаниеОшибки() + " — отправляем без плана.");
        Возврат Новый ТаблицаЗначений;
    КонецПопытки;

КонецФункции


// ─── СТАТИСТИКА ЧЕКОВ ─────────────────────────────────────────────────────────
// Возвращает по каждому складу агрегаты:
//   - КоличествоЧеков (уникальных НомерЧекаККМ по складу за период)
//   - ЧековСКартой (где ДисконтнаяКарта <> ПустаяСсылка)
//   - СуммаДок (общая выручка через шапку чека — параллельная проверка к sales)
//   - Скидки в разбивке: ручная, авто, подарочные сертификаты, бонусы
//
// На стороне дашборда из этого считаются:
//   - Средний чек = СуммаДок / КоличествоЧеков
//   - % чеков с картой = ЧековСКартой / КоличествоЧеков
//   - Графики "Скидки по видам"
//
Функция ПолучитьСтатистикуЧеков(НачПериода, КонПериода)

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |    ЧекККМ.Склад.Код                                          КАК СкладКод,
    |    КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЧекККМ.НомерЧекаККМ)                 КАК КоличествоЧеков,
    |    СУММА(ВЫБОР КОГДА ЧекККМ.ДисконтнаяКарта <> ЗНАЧЕНИЕ(Справочник.ДисконтныеКарты.ПустаяСсылка)
    |              ТОГДА 1 ИНАЧЕ 0 КОНЕЦ)                          КАК ЧековСКартой,
    |    СУММА(ЧекККМ.СуммаДокумента)                              КАК СуммаДок,
    |    СУММА(ЧекККМТовары.СуммаСкидки)                           КАК СуммаСкидкиВсего,
    |    СУММА(ЧекККМТовары.ОплатаПодарочнымиСертификатами)        КАК ПодарочныеСе,
    |    СУММА(ЧекККМТовары.ОплатаБонусами)                        КАК Бонусы
    |ИЗ
    |    Документ.ЧекККМ КАК ЧекККМ
    |        ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЧекККМ.Товары КАК ЧекККМТовары
    |        ПО ЧекККМТовары.Ссылка = ЧекККМ.Ссылка
    |ГДЕ
    |    ЧекККМ.Дата МЕЖДУ &НачПериода И &КонПериода
    |    И ЧекККМ.Проведен
    |    И ЧекККМ.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЧекККМ.Продажа)
    |    И ЧекККМ.НомерЧекаККМ <> 0
    |СГРУППИРОВАТЬ ПО
    |    ЧекККМ.Склад.Код";

    Запрос.УстановитьПараметр("НачПериода", НачПериода);
    Запрос.УстановитьПараметр("КонПериода", КонПериода);

    Попытка
        Результат = Запрос.Выполнить().Выгрузить();
        Сообщить("Чеки: получено " + Результат.Количество() + " магазинов со статистикой");
        Возврат Результат;
    Исключение
        Сообщить("Статистика чеков не получена: " + ОписаниеОшибки() + " — отправляем без неё.");
        Возврат Новый ТаблицаЗначений;
    КонецПопытки;

КонецФункции


// Конвертация статистики чеков в JSON-формат
Функция СформироватьСтатистикуЧеков(ТабЧеки)
    Результат = Новый Массив;
    Для Каждого Стр Из ТабЧеки Цикл
        Если ПустаяСтрока(Стр.СкладКод) Тогда Продолжить КонецЕсли;
        Результат.Добавить(Новый Структура(
            "storeId,chequeCount,withCardCount,factSum,discountSum,paymentGift,paymentBonus",
            Стр.СкладКод,
            Стр.КоличествоЧеков,
            Стр.ЧековСКартой,
            Стр.СуммаДок,
            Стр.СуммаСкидкиВсего,
            Стр.ПодарочныеСе,
            Стр.Бонусы));
    КонецЦикла;
    Возврат Результат;
КонецФункции


// ─── СБОРКА МАГАЗИНОВ ─────────────────────────────────────────────────────────
// source = "retail" / "corporate" / "mixed" определяется по тому,
// из каких потоков данных пришли строки для этого склада.
//
Функция СобратьМагазины(ТабПродажи, ТабПланы)

    // СкладКод -> Структура(name, sources Соответствие)
    Магазины = Новый Соответствие;

    Для Каждого Стр Из ТабПродажи Цикл
        Если ПустаяСтрока(Стр.СкладКод) Тогда Продолжить КонецЕсли;
        Если Магазины.Получить(Стр.СкладКод) = Неопределено Тогда
            Магазины.Вставить(Стр.СкладКод, Новый Структура(
                "name,sources",
                Стр.СкладНаим, Новый Соответствие));
        КонецЕсли;
        Магазины[Стр.СкладКод].sources.Вставить(Стр.Источник, Истина);
    КонецЦикла;

    // Магазины из планов (которых нет в продажах) — без источника
    Для Каждого Стр Из ТабПланы Цикл
        Если ПустаяСтрока(Стр.СкладКод) Тогда Продолжить КонецЕсли;
        Если Магазины.Получить(Стр.СкладКод) = Неопределено Тогда
            Магазины.Вставить(Стр.СкладКод, Новый Структура(
                "name,sources",
                Стр.СкладНаим, Новый Соответствие));
        КонецЕсли;
    КонецЦикла;

    Результат = Новый Массив;
    Для Каждого КЗ Из Магазины Цикл
        Источник = "";
        ИстРозница = КЗ.Значение.sources.Получить("retail");
        ИстОпт     = КЗ.Значение.sources.Получить("corporate");
        Если ИстРозница = Истина И ИстОпт = Истина Тогда
            Источник = "mixed";
        ИначеЕсли ИстРозница = Истина Тогда
            Источник = "retail";
        ИначеЕсли ИстОпт = Истина Тогда
            Источник = "corporate";
        КонецЕсли;
        // Формат магазина — пытаемся взять из реквизита Склада (если есть).
        // Если реквизит отсутствует — пустая строка, дашборд покажет
        // "— без формата" в соответствующем отчёте.
        Формат = "";
        Попытка
            СпрСклад = Справочники.Склады.НайтиПоКоду(КЗ.Ключ);
            Если ЗначениеЗаполнено(СпрСклад) Тогда
                Реквизит = СпрСклад.Метаданные().Реквизиты.Найти("ФорматМагазина");
                Если Реквизит <> Неопределено Тогда
                    Формат = "" + СпрСклад.ФорматМагазина;
                КонецЕсли;
            КонецЕсли;
        Исключение
            // ignore — реквизит отсутствует в этой конфигурации
        КонецПопытки;
        Результат.Добавить(Новый Структура(
            "id,name,region,source,format",
            КЗ.Ключ, КЗ.Значение.name, "Иркутск", Источник, Формат));
    КонецЦикла;
    Возврат Результат;

КонецФункции


// ─── СБОРКА НОМЕНКЛАТУРЫ ──────────────────────────────────────────────────────
Функция СобратьНоменклатуру(ТабПродажи)

    Товары = Новый Соответствие;
    Для Каждого Стр Из ТабПродажи Цикл
        Если ПустаяСтрока(Стр.ТоварКод) Тогда Продолжить КонецЕсли;
        Категория = Стр.Категория;
        Если ПустаяСтрока(Категория) Тогда
            Категория = "Прочее";
        КонецЕсли;
        Товары.Вставить(Стр.ТоварКод, Новый Структура(
            "id,name,category", Стр.ТоварКод, Стр.ТоварНаим, Категория));
    КонецЦикла;

    // Синтетический "товар" для строк плана только-по-магазину
    Товары.Вставить("_total", Новый Структура(
        "id,name,category", "_total", "ИТОГО по магазину", "План"));

    Результат = Новый Массив;
    Для Каждого КЗ Из Товары Цикл
        Результат.Добавить(КЗ.Значение);
    КонецЦикла;
    Возврат Результат;

КонецФункции


// ─── ПЛАНЫ → JSON-формат ──────────────────────────────────────────────────────
Функция СформироватьПланы(ТабПланы)
    Результат = Новый Массив;
    Для Каждого Стр Из ТабПланы Цикл
        Если ПустаяСтрока(Стр.СкладКод) Или ПустаяСтрока(Стр.ТоварКод) Тогда
            Продолжить;
        КонецЕсли;
        Результат.Добавить(Новый Структура(
            "storeId,productId,amount",
            Стр.СкладКод, Стр.ТоварКод, Стр.СуммаПлана));
    КонецЦикла;
    Возврат Результат;
КонецФункции


// ─── ПРОДАЖИ → JSON-формат (с мерджем себестоимости) ──────────────────────────
Функция СформироватьПродажи(ТабПродажи, ТабСебестоимость)

    // Карта себестоимости: "СкладКод|ТоварКод" -> Сумма
    КартаСебестоимости = Новый Соответствие;
    Для Каждого СС Из ТабСебестоимость Цикл
        Ключ = СС.СкладКод + "|" + СС.ТоварКод;
        КартаСебестоимости.Вставить(Ключ, СС.СуммаСебестоимости);
    КонецЦикла;

    Результат = Новый Массив;
    Для Каждого Стр Из ТабПродажи Цикл
        Если ПустаяСтрока(Стр.СкладКод) Или ПустаяСтрока(Стр.ТоварКод) Тогда
            Продолжить;
        КонецЕсли;

        Если ЗначениеЗаполнено(Стр.ПоследняяДата) Тогда
            ДатаПродажи = Формат(Стр.ПоследняяДата, "ДФ=yyyy-MM-ddTHH:mm:ss") + "+08:00";
        Иначе
            ДатаПродажи = Формат(ТекущаяДата(), "ДФ=yyyy-MM-ddTHH:mm:ss") + "+08:00";
        КонецЕсли;

        Ключ = Стр.СкладКод + "|" + Стр.ТоварКод;
        Себестоимость = КартаСебестоимости.Получить(Ключ);
        Если Себестоимость = Неопределено Тогда
            Себестоимость = 0;
        КонецЕсли;

        Результат.Добавить(Новый Структура(
            "storeId,productId,amount,cost,quantity,soldAt",
            Стр.СкладКод, Стр.ТоварКод,
            Стр.Выручка, Себестоимость, Стр.Количество,
            ДатаПродажи));
    КонецЦикла;
    Возврат Результат;

КонецФункции


// ─── HTTP / JSON ──────────────────────────────────────────────────────────────
Функция СериализоватьJSON(Значение)
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, Значение);
    Возврат ЗаписьJSON.Закрыть();
КонецФункции


Функция ОтправитьPOST(Хост, Порт, Путь, ApiKey, ТелоJSON)
    Защита     = Новый ЗащищенноеСоединениеOpenSSL();
    Соединение = Новый HTTPСоединение(Хост, Порт, , , , , Защита);
    Запрос     = Новый HTTPЗапрос(Путь);
    Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    Запрос.Заголовки.Вставить("X-API-Key", ApiKey);
    Запрос.УстановитьТелоИзСтроки(ТелоJSON, КодировкаТекста.UTF8);
    Ответ        = Соединение.ОтправитьДляОбработки(Запрос);
    ОтветСтрокой = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
    Если Ответ.КодСостояния <> 200 Тогда
        Сообщить("Дашборд HTTP=" + Ответ.КодСостояния + ": " + ОтветСтрокой);
    КонецЕсли;
    Возврат ОтветСтрокой;
КонецФункции


////////////////////////////////////////////////////////////////////////////////
// ─── ДИАГНОСТИЧЕСКАЯ ВЫГРУЗКА (СТРУКТУРА КОНФИГУРАЦИИ) ──────────────────────
//
// Шлёт раз в сутки (вызов из ВыполнитьВыгрузкуВДашборд() в час 0)
// полный снимок метаданных + sample 50 строк из ключевых регистров.
//
// На дашборде доступно по адресу:
//   https://sales-plan-dashboard.onrender.com/admin/upp-explorer.html
//
// Это позволяет разработчику дашборда смотреть структуру 1С Марии
// (216 регистров накопления, 358 документов, 447 справочников и т.д.)
// без беспокойства разработчика 1С при каждом вопросе.
////////////////////////////////////////////////////////////////////////////////


Процедура ВыгрузитьДиагностикуВДашборд() Экспорт

    Хост   = "sales-plan-dashboard.onrender.com";
    Порт   = 443;
    Путь   = "/api/ingest/upp-diagnostic";
    ApiKey = "85307b26064e3764b0b19ce3223353057b0fe754b31f0f3a";

    Объекты = Новый Массив;

    // Регистры накопления
    Для Каждого МД Из Метаданные.РегистрыНакопления Цикл
        Объекты.Добавить(СобратьМетаОбъекта_РН(МД));
    КонецЦикла;

    // Регистры сведений
    Для Каждого МД Из Метаданные.РегистрыСведений Цикл
        Объекты.Добавить(СобратьМетаОбъекта_РС(МД));
    КонецЦикла;

    // Документы
    Для Каждого МД Из Метаданные.Документы Цикл
        Объекты.Добавить(СобратьМетаОбъекта_Док(МД));
    КонецЦикла;

    // Справочники
    Для Каждого МД Из Метаданные.Справочники Цикл
        Объекты.Добавить(СобратьМетаОбъекта_Спр(МД));
    КонецЦикла;

    // Перечисления + значения
    Для Каждого МД Из Метаданные.Перечисления Цикл
        ОбМ = НовыйОбъектМеты("Перечисление", МД.Имя, МД.Синоним);
        СписокЗначений = Новый Массив;
        Для Каждого Зн Из МД.ЗначенияПеречисления Цикл
            СписокЗначений.Добавить(Новый Структура("name,synonym", Зн.Имя, Зн.Синоним));
        КонецЦикла;
        ОбМ.Вставить("values", СписокЗначений);
        Объекты.Добавить(ОбМ);
    КонецЦикла;

    // Sample-данные (текущий месяц, до 50 строк)
    НачМес = НачалоМесяца(ТекущаяДата());
    КонМес = КонецДня(КонецМесяца(ТекущаяДата()));

    ДобавитьСампл(Объекты, "РегистрНакопления", "Продажи",
        "ВЫБРАТЬ ПЕРВЫЕ 50 * ИЗ РегистрНакопления.Продажи "
        + " ГДЕ Период МЕЖДУ &Н И &К", НачМес, КонМес);

    ДобавитьСампл(Объекты, "РегистрНакопления", "ПродажиСебестоимость",
        "ВЫБРАТЬ ПЕРВЫЕ 50 * ИЗ РегистрНакопления.ПродажиСебестоимость "
        + " ГДЕ Период МЕЖДУ &Н И &К", НачМес, КонМес);

    ДобавитьСампл(Объекты, "РегистрНакопления", "ф_ПланФактПоПродавцам",
        "ВЫБРАТЬ ПЕРВЫЕ 50 * ИЗ РегистрНакопления.ф_ПланФактПоПродавцам "
        + " ГДЕ Период МЕЖДУ &Н И &К", НачМес, КонМес);

    ДобавитьСампл(Объекты, "РегистрНакопления", "ПланыПродаж",
        "ВЫБРАТЬ ПЕРВЫЕ 50 * ИЗ РегистрНакопления.ПланыПродаж "
        + " ГДЕ Период МЕЖДУ &Н И &К", НачМес, КонМес);

    ДобавитьСампл(Объекты, "РегистрНакопления", "ПродажиПоПродавцам",
        "ВЫБРАТЬ ПЕРВЫЕ 50 * ИЗ РегистрНакопления.ПродажиПоПродавцам "
        + " ГДЕ Период МЕЖДУ &Н И &К", НачМес, КонМес);

    // Альтернативный источник себестоимости — через универсальный регистр
    // УчетПродажИСебестоимости. У него есть отдельный ресурс «Себестоимость»
    // (а не просто «Стоимость», как в ПродажиСебестоимость). Если в нём есть
    // розничные продажи — мы сможем считать маржу для розничных точек.
    ДобавитьСампл(Объекты, "РегистрНакопления", "УчетПродажИСебестоимости",
        "ВЫБРАТЬ ПЕРВЫЕ 50 * ИЗ РегистрНакопления.УчетПродажИСебестоимости "
        + " ГДЕ Период МЕЖДУ &Н И &К", НачМес, КонМес);

    // Розничный остаток — есть продажная стоимость, но нет себестоимости.
    ДобавитьСампл(Объекты, "РегистрНакопления", "ТоварыВРознице",
        "ВЫБРАТЬ ПЕРВЫЕ 30 * ИЗ РегистрНакопления.ТоварыВРознице.Обороты(&Н, &К, Регистратор, )", НачМес, КонМес);

    // Главное — партии товаров. Именно отсюда берётся себестоимость продаж.
    // СтоимостьРасход за период = себестоимость списанного товара (~продажи).
    ДобавитьСампл(Объекты, "РегистрНакопления", "ПартииТоваровНаСкладах",
        "ВЫБРАТЬ ПЕРВЫЕ 50 Склад.Код КАК СкладКод, Номенклатура.Код КАК ТоварКод,
        | СтоимостьРасход, КоличествоРасход
        |ИЗ РегистрНакопления.ПартииТоваровНаСкладах.Обороты(&Н, &К, Регистратор, )
        |ГДЕ СтоимостьРасход > 0", НачМес, КонМес);

    Пакет = Новый Структура;
    Пакет.Вставить("configurationName",    Метаданные.Имя);
    Пакет.Вставить("configurationVersion", Метаданные.Версия);
    Пакет.Вставить("snapshotAt",           Формат(ТекущаяДата(), "ДФ=yyyy-MM-ddTHH:mm:ss"));
    Пакет.Вставить("objects",              Объекты);

    JSONСтрока = СериализоватьJSON(Пакет);
    Ответ      = ОтправитьPOST(Хост, Порт, Путь, ApiKey, JSONСтрока);
    Сообщить("Диагностика 1С отправлена (" + Объекты.Количество() + " объектов): " + Ответ);

КонецПроцедуры


Функция НовыйОбъектМеты(Вид, Имя, Синоним)
    Стр = Новый Структура;
    Стр.Вставить("kind", Вид);
    Стр.Вставить("name", Имя);
    Стр.Вставить("synonym", Синоним);
    Стр.Вставить("properties", Новый Массив);
    Возврат Стр;
КонецФункции


Функция НовоеСвойство(КлассСвойства, Имя, Синоним, Тип)
    Стр = Новый Структура;
    Стр.Вставить("kind", КлассСвойства);
    Стр.Вставить("name", Имя);
    Стр.Вставить("synonym", Синоним);
    Стр.Вставить("type", "" + Тип);
    Возврат Стр;
КонецФункции


Функция СобратьМетаОбъекта_РН(МД)
    ОбМ = НовыйОбъектМеты("РегистрНакопления", МД.Имя, МД.Синоним);
    Для Каждого Изм Из МД.Измерения Цикл
        ОбМ.properties.Добавить(НовоеСвойство("Измерение", Изм.Имя, Изм.Синоним, Изм.Тип));
    КонецЦикла;
    Для Каждого Рес Из МД.Ресурсы Цикл
        ОбМ.properties.Добавить(НовоеСвойство("Ресурс", Рес.Имя, Рес.Синоним, Рес.Тип));
    КонецЦикла;
    Для Каждого Рек Из МД.Реквизиты Цикл
        ОбМ.properties.Добавить(НовоеСвойство("Реквизит", Рек.Имя, Рек.Синоним, Рек.Тип));
    КонецЦикла;
    Возврат ОбМ;
